---
// Cuadrícula de Equipamiento de Backline Requerido por Instrumento
---
<div class="bg-slate-900/40 border border-white/5 rounded-3xl p-6 relative overflow-hidden" id="backline-grid-root">
  <div class="mb-6">
    <h3 class="font-title font-bold text-lg uppercase text-white mb-1">Requerimientos de Backline por Instrumento</h3>
    <p class="text-xs text-slate-400 leading-relaxed">
      Especificaciones técnicas, amplificación y atriles requeridos en escenario para cada instrumento del show. 
      <strong>Nota:</strong> Los músicos de Banda Bruna viajan con sus propios instrumentos principales.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="backline-grid-cards">
    <!-- Se inyectarán dinámicamente o mostrarán por defecto -->
    <div class="col-span-full py-8 text-center text-xs text-slate-400 animate-pulse uppercase tracking-widest">
      Cargando requerimientos de backline...
    </div>
  </div>
</div>

<script>
  import { supabase } from '../../services/supabaseClient.js';

  const BACKLINE_INSTRUMENTS = [
    { id: 'vocal', name: 'Voz Vocal', icon: '🎤', rec: 'Shure Beta 58 Wireless / Sennheiser EW-D', defaultItems: ['Micrófono inalámbrico Shure Beta 58', 'Atril de micrófono con brazo jirafa', 'Agua mineral a temperatura ambiente', 'Toalla limpia en escenario'] },
    { id: 'bajo', name: 'Bajo', icon: '🎸', rec: 'Ampeg SVT-CL / SVT-4PRO o Gallien Krueger 800RB', defaultItems: ['Cabezal de bajo a tubos de mínimo 300W', 'Gabinete de 4x10" o 8x10"', 'Línea directa activa (DI) de alta calidad', 'Atril de bajo en escenario'] },
    { id: 'guitarra', name: 'Guitarra', icon: '🎸', rec: 'Fender Twin Reverb, Hot Rod Deluxe o Marshall DSL40', defaultItems: ['Amplificador de guitarra valvular de mínimo 40W', 'Caja directa para guitarra acústica', 'Atril de guitarra en escenario', 'Alimentación eléctrica 220V cercana'] },
    { id: 'piano', name: 'Piano / Teclado', icon: '🎹', rec: 'Atriles K&M o Hercules reforzados', defaultItems: ['Soporte doble de teclado tipo "X" o "Z" reforzado', '2 Cajas Directas pasivas de alta gama', 'Toma de corriente 220V certificada', 'Atril de partitura con luz LED'] },
    { id: 'guiro', name: 'Güiro', icon: '🪵', rec: 'Güiro de metal LP o Meinl profesional', defaultItems: ['Atril/Soporte para percusión menor', 'Güiro metálico profesional con rascador de metal', 'Micrófono de percusión SM57 o clip', 'Punto de hidratación'] },
    { id: 'congas', name: 'Congas', icon: '🪘', rec: 'LP Classic o Giovanni Series', defaultItems: ['Par de congas (Quinto 11" y Conga 11.75") con soporte', 'Bongó profesional con soporte de pie', 'Tarima sólida de 2x2 metros (altura 40cm)', 'Atril de platillo para chimes'] },
    { id: 'timbal', name: 'Timbal / Batería', icon: '🥁', rec: 'DW Collector\'s, Pearl Reference o LP Tito Puente', defaultItems: ['Bombo de 22" (con orificio para mic)', 'Toms aéreos 10" y 12", Tom de piso 14" o 16"', 'Atril de caja y atril de Hi-Hat profesional', '5 atriles de platillo de doble felpa', 'Silla neumática para baterista'] }
  ];

  async function loadBacklineGrid() {
    const container = document.getElementById('backline-grid-cards');
    if (!container) return;

    const { data: reqs } = await supabase
      .from('rider_requerimientos')
      .select('*');

    const reqsMap: Record<string, string[]> = {};
    if (reqs) {
      reqs.forEach((r: any) => {
        reqsMap[r.categoria] = r.items || [];
      });
    }

    container.innerHTML = BACKLINE_INSTRUMENTS.map(inst => {
      const items = reqsMap[`backline_${inst.id}`] && reqsMap[`backline_${inst.id}`].length > 0 
        ? reqsMap[`backline_${inst.id}`]
        : inst.defaultItems;

      return `
        <div class="bg-slate-950/60 border border-white/5 p-5 rounded-2xl flex flex-col justify-between hover:border-gold-bruna/20 transition-all group">
          <div>
            <div class="w-10 h-10 rounded-lg bg-slate-900 flex items-center justify-center text-gold-bruna text-xl group-hover:scale-105 transition-transform mb-4">
              ${inst.icon}
            </div>
            <h4 class="font-title font-bold text-sm text-white uppercase mb-2">${inst.name}</h4>
            <ul class="text-[11px] text-slate-400 flex flex-col gap-1.5 list-disc pl-4">
              ${items.map(item => `<li>${item}</li>`).join('')}
            </ul>
          </div>
          <div class="border-t border-white/5 pt-3 mt-4 text-[10px] text-slate-450 font-mono">
            Recomendado: ${inst.rec}
          </div>
        </div>
      `;
    }).join('');
  }

  loadBacklineGrid();
</script>
