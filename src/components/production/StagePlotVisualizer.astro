---
// Visor del Stage Plot Oficial (Distribución Ilustrada de Músicos y Monitores en el Escenario)
interface Member {
  name: string;
  role: string;
  aux: string;
  type: 'iem' | 'wedge';
  hasAC?: boolean;
}

const stageMembers: Member[] = [
  { name: 'César Bruna', role: 'Voz Principal', aux: 'Aux 6 Bodypack', type: 'iem' },
  { name: 'Fabián Garrido', role: 'Güiro / Animación', aux: 'Aux 4 Bodypack', type: 'iem' },
  { name: 'Vicente Núñez', role: 'Guitarra Eléctrica / Dirección', aux: 'Aux 4 Bodypack', type: 'iem', hasAC: true },
  { name: 'Gerson Ulloa', role: 'Bajo Eléctrico', aux: 'Aux 5 Bodypack + Aux 8 Wedge', type: 'iem', hasAC: true },
  { name: 'Israel Lagos Rocha', role: 'Pianos / Teclados', aux: 'Aux 1 XLR', type: 'iem', hasAC: true },
  { name: 'Jaime Cárdenas Quilodrán', role: 'Batería / Timbales', aux: 'Aux 2 XLR + Aux 7 Wedge', type: 'wedge', hasAC: true },
  { name: 'Jaime Cárdenas Sanhueza', role: 'Congas / Bongós', aux: 'Aux 3 XLR', type: 'iem', hasAC: true },
];
---

<div class="bg-slate-900/40 border border-white/5 rounded-3xl p-6 md:p-8 relative overflow-hidden" id="stage-plot-root">
  <div class="absolute -top-40 -left-40 w-80 h-80 bg-gold-bruna/5 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Encabezado y Selector de Opciones -->
  <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4 mb-6">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="px-2 py-0.5 rounded text-[9px] font-mono font-bold uppercase tracking-wider bg-gold-bruna/10 text-gold-bruna border border-gold-bruna/20">
          Oficial 2026 - 2027
        </span>
        <span class="text-[10px] text-slate-400 font-mono">2 Variantes de Montaje</span>
      </div>
      <h3 class="font-title font-bold text-xl uppercase text-white tracking-wide">Stage Plot (Orden en Escenario)</h3>
      <p class="text-xs text-slate-400">Diagrama ilustrado con ubicación exacta de músicos, backline, sistemas de retorno y energía 220V.</p>
    </div>

    <!-- Controles: Selector de Opciones y Descarga -->
    <div class="flex flex-wrap items-center gap-2">
      <!-- Selector de Variante -->
      <div class="inline-flex p-1 bg-slate-950/80 border border-white/10 rounded-xl" role="tablist">
        <button 
          id="btn-stage-opt-1" 
          type="button" 
          class="stage-opt-btn active px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider transition-all cursor-pointer bg-gold-bruna text-black shadow-md shadow-gold-bruna/20"
          data-target="plot-option-1"
        >
          Opción 1: Típica (Frontal)
        </button>
        <button 
          id="btn-stage-opt-2" 
          type="button" 
          class="stage-opt-btn px-4 py-2 rounded-lg text-xs font-bold uppercase tracking-wider transition-all cursor-pointer text-slate-400 hover:text-white"
          data-target="plot-option-2"
        >
          Opción 2: Teclados Lateral
        </button>
      </div>

      <!-- Botón Descargar PDF -->
      <a 
        href="/assets/downloads/stageplot_banda_bruna.pdf" 
        target="_blank" 
        rel="noopener" 
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold uppercase tracking-wider bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white border border-white/10 transition-colors"
        title="Descargar Ficha en PDF"
      >
        <span>📄</span>
        <span>Descargar PDF</span>
      </a>
    </div>
  </div>

  <!-- Contenedor Principal de Visualización -->
  <div class="relative bg-slate-950 border border-white/10 rounded-2xl overflow-hidden shadow-2xl p-2 sm:p-4">
    
    <!-- Barra superior interna con badges explicativos -->
    <div class="flex flex-wrap items-center justify-between gap-2 px-3 py-2 border-b border-white/5 bg-slate-900/60 rounded-xl mb-3 text-[11px]">
      <div id="plot-description-1" class="plot-desc text-slate-300 font-mono flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-gold-bruna animate-pulse"></span>
        <span><strong>OPCIÓN 1:</strong> Distribución estándar en 2 líneas frontales. Ideal para la mayoría de escenarios y festivales.</span>
      </div>
      <div id="plot-description-2" class="plot-desc hidden text-slate-300 font-mono flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span><strong>OPCIÓN 2:</strong> Teclados en ángulo lateral mirando al centro de la banda. Ideal para escenarios profundos.</span>
      </div>

      <button 
        id="btn-open-stage-zoom" 
        type="button" 
        class="text-gold-bruna hover:text-white text-[11px] font-bold uppercase tracking-wider inline-flex items-center gap-1 cursor-pointer transition-colors ml-auto"
      >
        <span>🔍</span>
        <span>Pantalla Completa</span>
      </button>
    </div>

    <!-- Panel Opción 1 -->
    <div id="plot-option-1" class="stage-plot-panel block transition-opacity duration-300">
      <div class="relative rounded-xl overflow-hidden bg-black/50 border border-white/5 flex items-center justify-center">
        <picture>
          <source srcset="/assets/images/rider/stage_plot_1.webp" type="image/webp" />
          <img 
            id="stage-img-1" 
            src="/assets/images/rider/stage_plot_1.png" 
            alt="Stage Plot Oficial Opción 1 - Banda Bruna" 
            class="w-full h-auto max-h-[580px] object-contain cursor-zoom-in"
            loading="lazy"
          />
        </picture>
      </div>
    </div>

    <!-- Panel Opción 2 -->
    <div id="plot-option-2" class="stage-plot-panel hidden transition-opacity duration-300">
      <div class="relative rounded-xl overflow-hidden bg-black/50 border border-white/5 flex items-center justify-center">
        <picture>
          <source srcset="/assets/images/rider/stage_plot_2.webp" type="image/webp" />
          <img 
            id="stage-img-2" 
            src="/assets/images/rider/stage_plot_2.png" 
            alt="Stage Plot Oficial Opción 2 - Banda Bruna" 
            class="w-full h-auto max-h-[580px] object-contain cursor-zoom-in"
            loading="lazy"
          />
        </picture>
      </div>
    </div>

    <!-- Pie del Visualizador con Leyenda -->
    <div class="mt-3 pt-3 border-t border-white/5 flex flex-wrap items-center justify-between gap-3 px-2 text-[10px] font-mono text-slate-400">
      <div class="flex items-center gap-4 flex-wrap">
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-gold-bruna"></span>
          <span class="text-white font-bold">IEM Inalámbrico</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
          <span class="text-white font-bold">Monitor Wedge Piso</span>
        </div>
        <div class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded bg-emerald-500"></span>
          <span class="text-white font-bold">220V Estabilizada</span>
        </div>
      </div>
      <div class="text-slate-500 uppercase tracking-wider">
        ▲ BOCA DE ESCENARIO (FRENTE AL PÚBLICO) ▲
      </div>
    </div>
  </div>

  <!-- Especificaciones Técnicas y Tarjetas de Músicos -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mt-6">
    <!-- Columna 1: Requerimientos Físicos del Escenario -->
    <div class="bg-slate-950/70 border border-white/5 rounded-2xl p-5 flex flex-col justify-between">
      <div>
        <h4 class="text-xs font-title font-bold text-gold-bruna uppercase tracking-wider mb-3 flex items-center gap-2">
          <span>📐</span> Requerimientos de Escenario
        </h4>
        <ul class="space-y-2.5 text-xs text-slate-300 font-mono">
          <li class="flex items-start gap-2">
            <span class="text-gold-bruna font-bold">•</span>
            <span><strong>Dimensiones mínimas:</strong> 10m de boca x 8m de fondo x 1.2m de altura.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-gold-bruna font-bold">•</span>
            <span><strong>Tarima Batería / Timbales:</strong> 2m x 2m, altura 40cm (con alfombra antideslizante).</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-gold-bruna font-bold">•</span>
            <span><strong>Tarima Congas / Bongós:</strong> 2m x 2m, altura 40cm.</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-gold-bruna font-bold">•</span>
            <span><strong>Electricidad en Escenario:</strong> 4 puntos dobles 220V estabilizada (Batería, Teclados, Guitarra y Bajo).</span>
          </li>
        </ul>
      </div>
      <div class="mt-4 pt-3 border-t border-white/5 text-[10px] text-slate-400">
        * Para escenarios de menores dimensiones, consultar con dirección técnica.
      </div>
    </div>

    <!-- Columna 2 y 3: Integrantes, Roles y Retornos -->
    <div class="lg:col-span-2 bg-slate-950/70 border border-white/5 rounded-2xl p-5">
      <div class="flex items-center justify-between mb-3">
        <h4 class="text-xs font-title font-bold text-gold-bruna uppercase tracking-wider flex items-center gap-2">
          <span>👥</span> Alineación de Músicos & Retornos
        </h4>
        <span class="text-[10px] text-slate-400 font-mono">7 Músicos en Escenario</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {stageMembers.map(m => (
          <div class="bg-slate-900/60 border border-white/5 rounded-xl p-2.5 flex items-center justify-between">
            <div>
              <p class="text-xs font-bold text-white uppercase leading-tight">{m.name}</p>
              <p class="text-[10px] text-slate-400 leading-tight mt-0.5">{m.role}</p>
            </div>
            <div class="flex items-center gap-1.5 shrink-0">
              <span class={`text-[9px] font-mono font-bold px-2 py-0.5 rounded border ${
                m.type === 'iem' 
                  ? 'bg-gold-bruna/10 text-gold-bruna border-gold-bruna/30' 
                  : 'bg-blue-500/10 text-blue-400 border-blue-500/30'
              }`}>
                {m.aux}
              </span>
              {m.hasAC && (
                <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30" title="Alimentación 220V">
                  220V
                </span>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Modal Lightbox para Pantalla Completa -->
  <div id="stage-zoom-modal" class="fixed inset-0 z-50 bg-black/95 backdrop-blur-md hidden opacity-0 transition-opacity duration-300 flex flex-col justify-between p-4 sm:p-6">
    <div class="flex items-center justify-between text-white border-b border-white/10 pb-3">
      <div>
        <h3 id="stage-zoom-title" class="text-base font-title font-bold uppercase text-gold-bruna">Stage Plot Oficial - Vista Detallada</h3>
        <p class="text-xs text-slate-400 font-mono">Ubicación física e instrumental a escala</p>
      </div>
      <button id="btn-close-stage-zoom" type="button" class="text-slate-400 hover:text-white text-2xl font-bold p-2 cursor-pointer transition-colors" title="Cerrar">
        ✕
      </button>
    </div>

    <div class="flex-grow flex items-center justify-center p-2 overflow-auto">
      <img id="stage-zoom-img" src="/assets/images/rider/stage_plot_1.png" alt="Stage Plot Grande" class="max-w-full max-h-[82vh] object-contain rounded-lg shadow-2xl" />
    </div>

    <div class="border-t border-white/10 pt-3 flex flex-wrap items-center justify-between text-xs text-slate-400 font-mono">
      <span>Banda Bruna • Rider Técnico Oficial</span>
      <span class="text-gold-bruna font-bold">contacto@bandabruna.cl</span>
    </div>
  </div>
</div>

<script>
  function initStagePlot() {
    const btnOpt1 = document.getElementById('btn-stage-opt-1');
    const btnOpt2 = document.getElementById('btn-stage-opt-2');
    const panel1 = document.getElementById('plot-option-1');
    const panel2 = document.getElementById('plot-option-2');
    const desc1 = document.getElementById('plot-description-1');
    const desc2 = document.getElementById('plot-description-2');

    const modal = document.getElementById('stage-zoom-modal');
    const modalImg = document.getElementById('stage-zoom-img') as HTMLImageElement;
    const modalTitle = document.getElementById('stage-zoom-title');
    const btnOpenZoom = document.getElementById('btn-open-stage-zoom');
    const btnCloseZoom = document.getElementById('btn-close-stage-zoom');
    const img1 = document.getElementById('stage-img-1');
    const img2 = document.getElementById('stage-img-2');

    let activeOption = 1;

    function selectOption(opt: number) {
      activeOption = opt;
      if (opt === 1) {
        btnOpt1?.classList.add('bg-gold-bruna', 'text-black', 'shadow-md', 'shadow-gold-bruna/20');
        btnOpt1?.classList.remove('text-slate-400');
        btnOpt2?.classList.remove('bg-gold-bruna', 'text-black', 'shadow-md', 'shadow-gold-bruna/20');
        btnOpt2?.classList.add('text-slate-400');

        panel1?.classList.remove('hidden');
        panel2?.classList.add('hidden');
        desc1?.classList.remove('hidden');
        desc2?.classList.add('hidden');
      } else {
        btnOpt2?.classList.add('bg-gold-bruna', 'text-black', 'shadow-md', 'shadow-gold-bruna/20');
        btnOpt2?.classList.remove('text-slate-400');
        btnOpt1?.classList.remove('bg-gold-bruna', 'text-black', 'shadow-md', 'shadow-gold-bruna/20');
        btnOpt1?.classList.add('text-slate-400');

        panel2?.classList.remove('hidden');
        panel1?.classList.add('hidden');
        desc2?.classList.remove('hidden');
        desc1?.classList.add('hidden');
      }
    }

    btnOpt1?.addEventListener('click', () => selectOption(1));
    btnOpt2?.addEventListener('click', () => selectOption(2));

    function openZoom() {
      if (!modal || !modalImg) return;
      if (activeOption === 1) {
        modalImg.src = '/assets/images/rider/stage_plot_1.png';
        if (modalTitle) modalTitle.textContent = 'Stage Plot Oficial - Opción 1: Distribución Estándar (Frontal)';
      } else {
        modalImg.src = '/assets/images/rider/stage_plot_2.png';
        if (modalTitle) modalTitle.textContent = 'Stage Plot Oficial - Opción 2: Distribución Alternativa (Teclados Lateral)';
      }

      modal.classList.remove('hidden');
      setTimeout(() => modal.classList.remove('opacity-0'), 10);
    }

    function closeZoom() {
      if (!modal) return;
      modal.classList.add('opacity-0');
      setTimeout(() => modal.classList.add('hidden'), 300);
    }

    btnOpenZoom?.addEventListener('click', openZoom);
    img1?.addEventListener('click', openZoom);
    img2?.addEventListener('click', openZoom);
    btnCloseZoom?.addEventListener('click', closeZoom);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeZoom();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeZoom();
      }
    });
  }

  // Ejecutar al cargar
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStagePlot);
  } else {
    initStagePlot();
  }
</script>
