---
import { supabase } from '../services/supabaseClient.js';

let dbCampaign = null;

try {
  const { data, error } = await supabase
    .from('featured_campaigns')
    .select('*')
    .eq('active', true)
    .order('created_at', { ascending: false })
    .limit(1);

  if (data && data.length > 0) {
    const activeCampaign = data[0];
    const now = new Date();
    let isDateValid = true;
    if (activeCampaign.start_date && new Date(activeCampaign.start_date) > now) isDateValid = false;
    if (activeCampaign.end_date && new Date(activeCampaign.end_date) < now) isDateValid = false;
    if (isDateValid) dbCampaign = activeCampaign;
  }
} catch (err) {
  console.error("Error al cargar la campaña destacada de Supabase:", err);
}

// Banner 1: Lanzamiento Especial Fiestas Patrias
const patrioCampaign = {
  id: 'sesion-fiestas-patrias',
  title: '¡ESTRENO: SESIÓN EN VIVO FIESTAS PATRIAS!',
  subtitle: 'Siente toda la fiesta, la cumbia sureña y la energía dieciochera de Banda Bruna en vivo. ¡Mira el video oficial y celebra con nosotros!',
  button_text: 'VER SESIÓN EN VIVO',
  button_url: '/sesion-fiestas-patrias',
  image_url: 'https://res.cloudinary.com/dhgifjpkh/image/upload/v1789574626/compressed_fiestas_patrias_BB_o5dkoj.webp',
  theme: 'patrio'
};

// Banner 2: Contrataciones Festivales de Verano 2027 (Recuperado y Preservado)
const veranoCampaign = {
  id: 'festivales-verano-2027',
  title: (dbCampaign && dbCampaign.button_url === '/contrataciones') ? dbCampaign.title : 'CONTRATA BANDA BRUNA PARA FESTIVALES DE VERANO 2027',
  subtitle: (dbCampaign && dbCampaign.button_url === '/contrataciones') ? dbCampaign.subtitle : 'Agenda abierta para festivales masivos, semanas aniversario comunales, eventos corporativos y celebraciones de fin de año en todo Chile.',
  button_text: (dbCampaign && dbCampaign.button_url === '/contrataciones') ? dbCampaign.button_text : 'SOLICITAR COTIZACIÓN',
  button_url: '/contrataciones',
  image_url: 'https://res.cloudinary.com/dhgifjpkh/image/upload/v1783398590/compressed_BB28_eykyvc.webp',
  theme: 'verano'
};

const campaigns = [patrioCampaign, veranoCampaign];
---

<div 
  id="campaign-banner-container"
  class="relative w-full overflow-hidden text-white z-40 transition-all duration-500 border-b border-gold-bruna/30"
>
  <style>
    /* Shimmer effect for call to action */
    .festival-cta-btn {
      position: relative;
      overflow: hidden;
    }
    .festival-cta-btn::after {
      content: '';
      position: absolute;
      top: -50%;
      left: -60%;
      width: 30%;
      height: 200%;
      background: linear-gradient(
        to right,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 0.3) 30%,
        rgba(255, 255, 255, 0.7) 50%,
        rgba(255, 255, 255, 0.3) 70%,
        rgba(255, 255, 255, 0) 100%
      );
      transform: rotate(30deg);
      animation: shimmer-effect 3.5s infinite ease-in-out;
    }
    @keyframes shimmer-effect {
      0% {
        left: -60%;
      }
      15%, 100% {
        left: 140%;
      }
    }
    .banner-slide {
      transition: opacity 0.5s ease-in-out;
    }
    .banner-slide.slide-active {
      opacity: 1;
      pointer-events: auto;
      position: relative;
    }
    .banner-slide.slide-hidden {
      opacity: 0;
      pointer-events: none;
      position: absolute;
      inset: 0;
    }
  </style>

  {campaigns.map((camp, idx) => {
    const isPatrio = camp.theme === 'patrio';
    return (
      <div 
        id={`banner-slide-${idx}`}
        data-slide-index={idx}
        class={`banner-slide w-full py-4 px-6 md:px-12 ${idx === 0 ? 'slide-active' : 'slide-hidden'} ${
          isPatrio 
            ? 'bg-gradient-to-r from-[#02081d] via-[#081845] to-[#450909]' 
            : 'bg-gradient-to-r from-[#030612] via-[#091535] to-[#1a1205]'
        }`}
      >
        <!-- Background Image Layer with opacity mask -->
        <div class="absolute inset-0 z-0 select-none pointer-events-none">
          <div 
            class="absolute right-0 top-0 h-full w-[55%] md:w-[44%] bg-cover bg-no-repeat opacity-45 md:opacity-85"
            style={`
              background-image: url('${camp.image_url}');
              background-position: center 25%;
              mask-image: linear-gradient(to left, rgba(0,0,0,1) 40%, rgba(0,0,0,0) 100%);
              -webkit-mask-image: linear-gradient(to left, rgba(0,0,0,1) 40%, rgba(0,0,0,0) 100%);
            `}
          ></div>

          <!-- Resplandores escénicos -->
          {isPatrio ? (
            <>
              <div class="absolute right-28 top-1/2 -translate-y-1/2 w-60 h-60 rounded-full bg-red-600/20 blur-3xl pointer-events-none"></div>
              <div class="absolute left-1/4 top-1/2 -translate-y-1/2 w-60 h-60 rounded-full bg-blue-600/15 blur-3xl pointer-events-none"></div>
              <div class="absolute bottom-0 left-0 w-full h-[2px] bg-gradient-to-r from-blue-600 via-white to-red-600"></div>
            </>
          ) : (
            <>
              <div class="absolute right-24 top-1/2 -translate-y-1/2 w-48 h-48 rounded-full bg-gold-bruna/10 blur-3xl pointer-events-none"></div>
              <div class="absolute bottom-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-gold-bruna/70 to-transparent"></div>
            </>
          )}
        </div>

        <!-- Content Container -->
        <div class="relative z-10 max-w-[1400px] mx-auto flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-6 pr-14 md:pr-48">
          <div class="flex-1 text-left">
            <div class="flex items-center gap-2 mb-1.5 flex-wrap">
              {isPatrio ? (
                <>
                  <span class="bg-gradient-to-r from-red-600 to-rose-700 text-white border border-red-400/40 text-[9px] font-extrabold tracking-widest px-2.5 py-0.5 rounded-sm uppercase font-title shadow-md flex items-center gap-1.5">
                    <span>🇨🇱</span> ESPECIAL FIESTAS PATRIAS
                  </span>
                  <span class="text-gold-bruna text-[10px] font-extrabold tracking-widest uppercase font-title flex items-center gap-1">
                    ★ NUEVA SESIÓN EN VIVO ★
                  </span>
                </>
              ) : (
                <>
                  <span class="bg-gradient-to-r from-amber-500 to-gold-bruna text-black border border-gold-bruna/40 text-[9px] font-extrabold tracking-widest px-2.5 py-0.5 rounded-sm uppercase font-title shadow-md flex items-center gap-1">
                    <span>☀️</span> TEMPORADA 2026 - 2027
                  </span>
                  <span class="text-gold-bruna text-[10px] font-extrabold tracking-widest uppercase font-title">
                    ★ GIRA DE FESTIVALES & VERANO ★
                  </span>
                </>
              )}
            </div>

            <h3 class="text-sm md:text-base font-extrabold font-title tracking-wide text-white uppercase mb-1 leading-tight flex flex-col md:flex-row md:items-center gap-3">
              <span>{camp.title}</span>
              <a 
                href={camp.button_url} 
                class={`hidden md:inline-flex festival-cta-btn ${
                  isPatrio 
                    ? 'bg-gradient-to-r from-red-600 to-rose-700 hover:from-red-500 hover:to-rose-600 text-white border-red-400/50 shadow-red-900/40' 
                    : 'bg-gradient-to-r from-gold-bruna to-gold-bruna-hover hover:from-amber-400 hover:to-amber-500 text-black border-gold-bruna/40 shadow-gold-bruna/20'
                } font-extrabold text-[10px] px-5 py-2 rounded border tracking-widest hover:scale-105 transition-all text-center uppercase shadow-lg active:scale-95 cursor-pointer shrink-0 items-center gap-2`}
              >
                <span>{isPatrio ? '🎬' : '📅'}</span> {camp.button_text} <span>➔</span>
              </a>
            </h3>

            <p class="text-xs text-slate-200 font-light max-w-3xl leading-relaxed">
              {camp.subtitle}
            </p>
          </div>

          <!-- Mobile Button Only -->
          <div class="flex items-center gap-3 w-full md:hidden shrink-0 mt-1">
            <a 
              href={camp.button_url} 
              class={`w-full festival-cta-btn ${
                isPatrio 
                  ? 'bg-gradient-to-r from-red-600 to-rose-700 text-white border-red-400/50 shadow-red-900/40' 
                  : 'bg-gradient-to-r from-gold-bruna to-gold-bruna-hover text-black border-gold-bruna/40 shadow-gold-bruna/20'
              } py-2.5 rounded border font-extrabold text-xs tracking-widest hover:scale-102 transition-all text-center uppercase active:scale-95 cursor-pointer shadow-lg flex items-center justify-center gap-2`}
            >
              <span>{isPatrio ? '🎬' : '📅'}</span> {camp.button_text} <span>➔</span>
            </a>
          </div>
        </div>
      </div>
    );
  })}

  <!-- Controles del Banner: Selector de Campañas (Píldoras) + Botón Cerrar -->
  <div class="absolute right-3 top-3 md:right-5 md:top-4 z-30 flex items-center gap-2">
    <!-- Píldoras de Navegación entre Banners -->
    <div class="flex items-center bg-black/70 backdrop-blur-md rounded-full border border-white/10 p-0.5 shadow-lg">
      <button 
        id="btn-switch-banner-0" 
        class="banner-pill-btn px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase transition-all bg-red-600 text-white cursor-pointer"
        aria-label="Ver anuncio de Fiestas Patrias"
      >
        🇨🇱 Fiestas Patrias
      </button>
      <button 
        id="btn-switch-banner-1" 
        class="banner-pill-btn px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase transition-all text-slate-400 hover:text-white cursor-pointer"
        aria-label="Ver anuncio de Festivales de Verano"
      >
        ☀️ Verano 2027
      </button>
    </div>

    <!-- Botón de Cerrar (X) -->
    <button 
      id="close-campaign-banner"
      class="text-slate-400 hover:text-white transition-colors cursor-pointer bg-black/70 hover:bg-black/90 backdrop-blur-md rounded-full w-7 h-7 flex items-center justify-center border border-white/10 text-xs"
      aria-label="Cerrar anuncios"
    >
      ✕
    </button>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('campaign-banner-container');
    if (!container) return;

    if (sessionStorage.getItem('closed_campaign_banner') === 'true') {
      container.style.display = 'none';
      return;
    }

    const closeBtn = document.getElementById('close-campaign-banner');
    if (closeBtn) {
      closeBtn.addEventListener('click', () => {
        container.style.maxHeight = '0';
        container.style.padding = '0';
        container.style.opacity = '0';
        sessionStorage.setItem('closed_campaign_banner', 'true');
        setTimeout(() => {
          container.style.display = 'none';
        }, 500);
      });
    }

    const slides = [
      document.getElementById('banner-slide-0'),
      document.getElementById('banner-slide-1')
    ];
    const pills = [
      document.getElementById('btn-switch-banner-0'),
      document.getElementById('btn-switch-banner-1')
    ];

    let current = 0;
    let timer = null;

    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('banner') === 'verano' || window.location.hash === '#verano') {
      current = 1;
    }

    function goToSlide(idx) {
      current = idx;
      slides.forEach((slide, i) => {
        if (!slide) return;
        if (i === current) {
          slide.classList.remove('slide-hidden');
          slide.classList.add('slide-active');
        } else {
          slide.classList.remove('slide-active');
          slide.classList.add('slide-hidden');
        }
      });

      pills.forEach((pill, i) => {
        if (!pill) return;
        if (i === current) {
          if (i === 0) {
            pill.className = 'banner-pill-btn px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase transition-all bg-red-600 text-white cursor-pointer';
          } else {
            pill.className = 'banner-pill-btn px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase transition-all bg-amber-500 text-black cursor-pointer';
          }
        } else {
          pill.className = 'banner-pill-btn px-2.5 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase transition-all text-slate-400 hover:text-white cursor-pointer';
        }
      });
    }

    pills.forEach((pill, idx) => {
      if (pill) {
        pill.addEventListener('click', () => {
          goToSlide(idx);
          resetTimer();
        });
      }
    });

    function startTimer() {
      timer = setInterval(() => {
        const next = (current + 1) % 2;
        goToSlide(next);
      }, 7000);
    }

    function resetTimer() {
      if (timer) clearInterval(timer);
      startTimer();
    }

    container.addEventListener('mouseenter', () => {
      if (timer) clearInterval(timer);
    });

    container.addEventListener('mouseleave', () => {
      resetTimer();
    });

    if (current !== 0) {
      goToSlide(current);
    }

    startTimer();
  });
</script>
