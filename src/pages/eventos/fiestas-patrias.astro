<script>
  function setupFiestasPatriasVideos() {
    // ==========================================
    // INTERACTIVIDAD DE VIDEOS VERTICALES 9:16
    // ==========================================
    const track = document.getElementById('vertical-video-track');
    const prevBtn = document.getElementById('prev-vertical');
    const nextBtn = document.getElementById('next-vertical');

    if (track && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -320, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: 320, behavior: 'smooth' });
      });
    }

    // ==========================================
    // FILTROS POR TEMPORADA (Todos / 2026 / 2025)
    // ==========================================
    const filterPills = document.querySelectorAll('[data-video-filter]');
    const allCards = document.querySelectorAll('.vertical-video-card');

    filterPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const filter = pill.getAttribute('data-video-filter');

        // Actualizar apariencia de las píldoras de filtro
        filterPills.forEach((p) => {
          if (p === pill) {
            p.classList.add('bg-gold-bruna', 'text-black', 'shadow-lg', 'shadow-gold-bruna/20');
            p.classList.remove('bg-slate-900/80', 'border', 'border-white/10', 'text-slate-300');
          } else {
            p.classList.remove('bg-gold-bruna', 'text-black', 'shadow-lg', 'shadow-gold-bruna/20');
            p.classList.add('bg-slate-900/80', 'border', 'border-white/10', 'text-slate-300');
          }
        });

        // Filtrar tarjetas
        allCards.forEach((card) => {
          const year = card.getAttribute('data-video-year');
          if (filter === 'all' || year === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });

        // Rebobinar el scroll del carrusel al inicio suavemente
        if (track) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        }
      });
    });

    // ==========================================
    // LIGHTBOX MODAL CON NAVEGACIÓN DINÁMICA
    // ==========================================
    const lightbox = document.getElementById('video-lightbox');
    const lightboxVid = document.getElementById('lightbox-video') as HTMLVideoElement | null;
    const lightboxIframeContainer = document.getElementById('lightbox-iframe-container');
    const mediaContainer = document.getElementById('lightbox-media-container');
    const lightboxTitle = document.getElementById('lightbox-video-title');
    const closeBtn = document.getElementById('close-lightbox');
    const prevBtnLightbox = document.getElementById('lightbox-prev');
    const nextBtnLightbox = document.getElementById('lightbox-next');

    let currentVisibleIndex = 0;

    function getVisibleCards(): HTMLElement[] {
      return Array.from(document.querySelectorAll<HTMLElement>('.vertical-video-card:not(.hidden)'));
    }

    // Extraer ID de YouTube en el cliente
    function getYouTubeIdClient(url: string) {
      if (!url) return '';
      if (url.includes('/shorts/')) {
        const parts = url.split('/shorts/');
        if (parts.length > 1) {
          return parts[1].split(/[?#&]/)[0];
        }
      }
      const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
      const match = url.match(regExp);
      return (match && match[2].length === 12) ? match[2].substring(0, 11) : (match && match[2].length === 11) ? match[2] : '';
    }

    function openVideo(index: number, pushToHistory = true) {
      const visible = getVisibleCards();
      if (visible.length === 0) return;

      if (index < 0) index = visible.length - 1;
      if (index >= visible.length) index = 0;
      currentVisibleIndex = index;

      const card = visible[currentVisibleIndex];
      const videoUrl = card.getAttribute('data-video-url');
      const videoTitle = card.getAttribute('data-video-title') || '';
      const aspect = card.getAttribute('data-video-aspect') || 'vertical';

      if (lightbox && videoUrl) {
        if (lightboxTitle) lightboxTitle.textContent = videoTitle;
        
        // Ajustar el aspecto del Lightbox (horizontal 16:9 o vertical 9:16)
        if (mediaContainer) {
          if (aspect === 'horizontal') {
            mediaContainer.className = "w-full max-w-4xl aspect-video bg-black rounded-2xl overflow-hidden border border-white/10 shadow-2xl relative flex items-center justify-center transition-all duration-300";
          } else {
            mediaContainer.className = "w-full max-w-[340px] aspect-[9/16] bg-black rounded-2xl overflow-hidden border border-white/10 shadow-2xl relative flex items-center justify-center transition-all duration-300";
          }
        }

        const ytId = getYouTubeIdClient(videoUrl);

        if (ytId) {
          // Si es YouTube, inyectar iframe y pausar reproductor nativo
          if (lightboxVid) {
            lightboxVid.pause();
            lightboxVid.src = '';
            lightboxVid.classList.add('hidden');
          }
          if (lightboxIframeContainer) {
            lightboxIframeContainer.innerHTML = `
              <iframe 
                src="https://www.youtube.com/embed/${ytId}?autoplay=1&rel=0" 
                title="${videoTitle}" 
                frameborder="0" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                allowfullscreen 
                class="w-full h-full"
              ></iframe>
            `;
            lightboxIframeContainer.classList.remove('hidden');
          }
        } else {
          // Si es MP4, limpiar iframe y usar reproductor nativo
          if (lightboxIframeContainer) {
            lightboxIframeContainer.innerHTML = '';
            lightboxIframeContainer.classList.add('hidden');
          }
          if (lightboxVid) {
            lightboxVid.src = videoUrl;
            lightboxVid.classList.remove('hidden');
            lightboxVid.play().catch(() => {});
          }
        }

        if (lightbox.classList.contains('hidden')) {
          lightbox.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
          
          if (pushToHistory) {
            history.pushState({ lightboxOpen: true }, '');
          }
        }
      }
    }

    function closeLightbox(shouldPopHistory = true) {
      if (lightbox) {
        if (lightboxVid) {
          lightboxVid.pause();
          lightboxVid.src = '';
        }
        if (lightboxIframeContainer) {
          lightboxIframeContainer.innerHTML = '';
          lightboxIframeContainer.classList.add('hidden');
        }
        lightbox.classList.add('hidden');
        document.body.style.overflow = '';
        
        if (shouldPopHistory && history.state && history.state.lightboxOpen) {
          history.back();
        }
      }
    }

    allCards.forEach((card) => {
      card.addEventListener('click', () => {
        const visible = getVisibleCards();
        const idx = visible.indexOf(card as HTMLElement);
        if (idx !== -1) {
          openVideo(idx, true);
        }
      });
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', () => closeLightbox(true));
    }
    if (lightbox) {
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) {
          closeLightbox(true);
        }
      });
    }

    if (prevBtnLightbox) {
      prevBtnLightbox.addEventListener('click', (e) => {
        e.stopPropagation();
        openVideo(currentVisibleIndex - 1, false);
      });
    }
    if (nextBtnLightbox) {
      nextBtnLightbox.addEventListener('click', (e) => {
        e.stopPropagation();
        openVideo(currentVisibleIndex + 1, false);
      });
    }

    // Botón atrás del navegador / móvil
    window.addEventListener('popstate', () => {
      if (lightbox && !lightbox.classList.contains('hidden')) {
        closeLightbox(false);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupFiestasPatriasVideos);
  document.addEventListener('astro:after-swap', setupFiestasPatriasVideos);
</script>
