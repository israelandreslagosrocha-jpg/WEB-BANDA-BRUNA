---
import Layout from '../layouts/Layout.astro';
import { anniversary } from '../data/anniversary';

const ticketHref = anniversary.ticketUrl || anniversary.flyer;
const updates = [...anniversary.updates].sort((a, b) => (b.published?.date ?? '').localeCompare(a.published?.date ?? ''));
const countdownUnits = [
  ['days', 'Días'],
  ['hours', 'Horas'],
  ['minutes', 'Minutos'],
  ['seconds', 'Segundos'],
];
---

<Layout title={anniversary.title} description={`Celebra el aniversario de Banda Bruna el ${anniversary.dateLabel}. Encuentra información sobre entradas, videos de saludos y novedades, y deja tu mensaje para la banda.`}>
  <section class="relative isolate overflow-hidden bg-[#100814] text-white" aria-labelledby="anniversary-title">
    <img src={anniversary.photo} alt="" fetchpriority="high" class="absolute inset-0 -z-20 h-full w-full object-cover object-center" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[#100814] via-[#100814]/90 to-[#100814]/65"></div>
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-16 sm:px-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:items-center lg:py-24">
      <div class="min-w-0">
        <time datetime={anniversary.date} class="font-title text-sm font-bold uppercase tracking-[0.2em] text-gold-bruna">{anniversary.dateLabel}</time>
        <h1 id="anniversary-title" class="mt-4 max-w-3xl font-title text-[clamp(2rem,10vw,3rem)] font-black uppercase leading-[0.95] sm:text-7xl">
          Fiesta Aniversario <span class="block text-gold-bruna">Banda Bruna</span>
        </h1>

        <div id="anniversary-countdown" class="mt-8" aria-label="Cuenta regresiva" hidden>
          <dl class="grid max-w-md grid-cols-4 gap-1 sm:gap-3" role="timer" aria-live="off">
            {countdownUnits.map(([key, label]) => (
              <div class="rounded-xl border border-white/20 bg-black/50 px-0.5 py-2 text-center sm:p-4">
                <dt class="text-[9px] uppercase text-slate-200 sm:text-xs">{label}</dt>
                <dd data-unit={key} class="mt-1 font-title text-2xl font-bold tabular-nums text-white sm:text-4xl"></dd>
              </div>
            ))}
          </dl>
        </div>
        <p id="anniversary-date-status" class="mt-6 font-title text-xl font-bold text-gold-bruna" hidden></p>

        <nav aria-label="Secciones del aniversario" class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold">
          <a href="#saludos" class="underline decoration-gold-bruna underline-offset-4">Deja tus buenos deseos</a>
          <a href="#videos-saludos" class="underline decoration-gold-bruna underline-offset-4">Videos de saludos</a>
          <a href="#novedades" class="underline decoration-gold-bruna underline-offset-4">Novedades</a>
        </nav>
      </div>

      <aside aria-labelledby="anniversary-tickets" class="overflow-hidden rounded-3xl border border-red-500/60 bg-[#100814]/95 shadow-[0_0_50px_rgba(220,38,38,0.25)]">
        {anniversary.flyer && (
          <a href={ticketHref} aria-label={anniversary.ticketUrl ? 'Comprar entradas desde el flyer oficial' : 'Ver flyer oficial'}>
            <img src={anniversary.flyer} alt="Flyer oficial de la Fiesta Aniversario Banda Bruna" class="mx-auto max-h-[34rem] w-full object-contain" />
          </a>
        )}
        <div class="p-6 sm:p-8">
          <h2 id="anniversary-tickets" class="font-title text-2xl font-bold text-white">Entradas y flyer oficial</h2>
          {ticketHref ? (
            <a href={ticketHref} class="mt-5 flex min-h-16 w-full items-center justify-center gap-3 rounded-xl bg-red-700 px-5 py-4 text-center font-title text-xl font-black leading-tight text-white shadow-lg shadow-red-600/40 transition hover:bg-red-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold-bruna sm:text-2xl">
              {anniversary.ticketUrl ? anniversary.ticketLabel : 'Ver flyer oficial'} <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <p class="mt-2 text-slate-300">Aquí encontrarás el flyer oficial y el enlace de compra cuando estén disponibles.</p>
          )}
          {anniversary.ticketUrl && <p class="mt-3 text-center text-sm text-slate-200">Venta oficial en Passline</p>}
        </div>
      </aside>
    </div>
  </section>

  <div class="bg-[#100814] text-white">
    <div class="mx-auto max-w-7xl space-y-16 px-4 py-14 sm:px-10">
      <section id="saludos" class="scroll-mt-24" aria-labelledby="wishes-title">
        <h2 id="wishes-title" class="font-title text-3xl font-bold">Deja tus buenos deseos</h2>
        <div class="mt-5 grid gap-6 lg:grid-cols-2">
          <form id="anniversary-wish-form" method="post" class="space-y-4 rounded-2xl border border-white/15 bg-white/5 p-5 sm:p-7">
            <p class="text-sm text-slate-300">Los saludos se publican después de una revisión.</p>
            <label class="block text-sm font-semibold">Tu nombre
              <input name="nombre" autocomplete="name" minlength="2" maxlength="80" required class="mt-2 w-full rounded-lg border border-white/20 bg-black/40 p-3" />
            </label>
            <label class="block text-sm font-semibold">Tu saludo
              <textarea name="comentario" rows="4" minlength="3" maxlength="600" required class="mt-2 w-full rounded-lg border border-white/20 bg-black/40 p-3"></textarea>
            </label>
            <div hidden><label>Sitio web <input name="website" tabindex="-1" autocomplete="off" /></label></div>
            <button type="submit" class="rounded-lg bg-gold-bruna px-5 py-3 font-bold text-black hover:bg-amber-300 disabled:opacity-50">Enviar saludo</button>
            <p id="anniversary-wish-status" role="status" class="text-sm text-slate-200"></p>
          </form>
          <div class="rounded-2xl border border-white/15 p-5 sm:p-7">
            <h3 class="font-title text-xl font-bold">Mensajes para Banda Bruna</h3>
            <p id="anniversary-wishes-status" class="mt-3 text-sm text-slate-300">Cargando saludos…</p>
            <ul id="anniversary-wishes" class="divide-y divide-white/10"></ul>
          </div>
        </div>
      </section>

      <section id="videos-saludos" class="scroll-mt-24" aria-labelledby="greetings-title">
        <h2 id="greetings-title" class="font-title text-3xl font-bold">Videos de saludos</h2>
        {anniversary.greetings.length ? (
          <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {anniversary.greetings.map(({ name, youtubeId, videoUrl }) => (
              <article class="overflow-hidden rounded-2xl border border-white/15">
                {youtubeId ? (
                  <iframe class="aspect-video w-full" src={`https://www.youtube-nocookie.com/embed/${encodeURIComponent(youtubeId)}`} title={`Saludo de ${name}`} loading="lazy" allowfullscreen></iframe>
                ) : (
                  <video src={videoUrl} controls playsinline preload="none" aria-label={`Saludo de ${name}`} class="aspect-video w-full bg-black"></video>
                )}
                <h3 class="p-4 font-bold">{name}</h3>
              </article>
            ))}
          </div>
        ) : <p class="mt-3 text-slate-300">Aquí compartiremos los saludos en video de artistas y amigos de la banda.</p>}
      </section>

      <section id="novedades" class="scroll-mt-24" aria-labelledby="updates-title">
        <h2 id="updates-title" class="font-title text-3xl font-bold">Novedades del aniversario</h2>
        {updates.length ? (
          <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {updates.map(update => (
              <article class:list={["rounded-2xl border border-white/15 bg-white/5 p-3 sm:p-5", update.instagramEmbedUrl && "sm:col-span-2"]}>
                {update.published && <time datetime={update.published.date} class="text-sm text-gold-bruna">{update.published.label}</time>}
                <h3 class="mt-2 text-xl font-bold">{update.title}</h3>
                <p class="mt-2 text-slate-300">{update.description}</p>
                {update.instagramEmbedUrl && (
                  <iframe
                    src={update.instagramEmbedUrl}
                    title={`${update.title} en Instagram`}
                    loading="lazy"
                    class="mt-4 aspect-[4/5] min-h-[420px] w-full max-w-[540px] rounded-xl bg-white"
                  ></iframe>
                )}
                {update.link && <a href={update.link.url} class="mt-4 inline-flex min-h-11 items-center font-bold text-gold-bruna underline">{update.link.label}</a>}
              </article>
            ))}
          </div>
        ) : <p class="mt-3 text-slate-300">En esta sección publicaremos invitaciones, concursos y anuncios de la fiesta.</p>}
      </section>
    </div>
  </div>
</Layout>

<script>
  import { anniversary } from '../data/anniversary';

  const countdown = document.getElementById('anniversary-countdown');
  const dateStatus = document.getElementById('anniversary-date-status');
  const dateFormatter = new Intl.DateTimeFormat('sv-SE', { timeZone: anniversary.timeZone });
  const target = Date.parse(anniversary.countdownTo);

  function updateCountdown() {
    if (!countdown || !dateStatus) return false;
    const now = new Date();
    const seconds = Math.ceil((target - now.getTime()) / 1000);
    if (seconds <= 0) {
      countdown.hidden = true;
      dateStatus.textContent = dateFormatter.format(now) === anniversary.date
        ? '¡Hoy es el aniversario!'
        : 'La fecha del aniversario ya pasó.';
      dateStatus.hidden = false;
      return false;
    }

    const values = {
      days: Math.floor(seconds / 86400),
      hours: Math.floor(seconds / 3600) % 24,
      minutes: Math.floor(seconds / 60) % 60,
      seconds: seconds % 60,
    };
    for (const [unit, value] of Object.entries(values)) {
      const element = countdown.querySelector(`[data-unit="${unit}"]`);
      if (element) element.textContent = String(value).padStart(2, '0');
    }
    countdown.hidden = false;
    return true;
  }

  if (updateCountdown()) {
    const timer = window.setInterval(() => {
      if (!updateCountdown()) window.clearInterval(timer);
    }, 1000);
  }

  const endpoint = '/api/launch-comments';
  const wishes = document.getElementById('anniversary-wishes');
  const wishesStatus = document.getElementById('anniversary-wishes-status');

  async function loadWishes() {
    if (!wishes || !wishesStatus) return;
    try {
      const response = await fetch(`${endpoint}?slug=${encodeURIComponent(anniversary.slug)}`);
      const { comments } = await response.json();
      if (!response.ok || !Array.isArray(comments)) throw new Error();
      for (const comment of comments) {
        const item = document.createElement('li');
        item.className = 'py-4';
        const name = document.createElement('p');
        name.className = 'font-bold text-gold-bruna';
        name.textContent = comment.nombre;
        const message = document.createElement('p');
        message.className = 'mt-1 whitespace-pre-wrap break-words text-slate-200';
        message.textContent = comment.comentario;
        item.append(name, message);
        wishes.append(item);
      }
      wishesStatus.textContent = comments.length ? '' : 'Todavía no hay saludos publicados.';
    } catch {
      wishesStatus.textContent = 'No pudimos cargar los saludos. Intenta recargar la página.';
    }
  }

  void loadWishes();

  const form = document.querySelector<HTMLFormElement>('#anniversary-wish-form');
  const wishStatus = document.getElementById('anniversary-wish-status');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  if (form && wishStatus && submit) {
    form.addEventListener('submit', async event => {
      event.preventDefault();
      const fields = Object.fromEntries(new FormData(form));
      submit.disabled = true;
      wishStatus.textContent = 'Enviando saludo…';

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...fields, lanzamiento_slug: anniversary.slug }),
        });
        const result = await response.json();
        if (!response.ok || !result.success) {
          wishStatus.textContent = response.status === 429
            ? 'Has enviado varios saludos. Intenta nuevamente más tarde.'
            : 'No pudimos enviar tu saludo. Revisa los datos o vuelve a intentarlo.';
          return;
        }
        form.reset();
        wishStatus.textContent = '¡Gracias por tu saludo! Lo revisaremos antes de publicarlo.';
      } catch {
        wishStatus.textContent = 'No pudimos enviar tu saludo. Intenta nuevamente.';
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>
