import Layout from '../layouts/Layout.astro';
import { 
  getLatestVideo, 
  getInstagramFeed, 
  getFacebookFeed 
} from '../services/socialApi.js';
import socialStats from '../data/socialStats.json';
import { supabase } from '../services/supabaseClient.js';
import NowPlayingWidget from '../modules/radio-monitor/components/NowPlayingWidget.astro';
import QuoteForm from '../components/forms/QuoteForm.astro';
import EventSlider from '../components/events/EventSlider.astro';
import TourCalendar from '../components/events/TourCalendar.astro';

// Fetch mock social data at build time
const latestVideo = getLatestVideo();
const instagramFeed = getInstagramFeed();
const facebookFeed = getFacebookFeed();

// Cargar eventos activos desde Supabase ordenados por fecha ascendente
const { data: rawEvents } = await supabase
  .from('eventos')
  .select('*')
  .eq('publicado', true)
  .order('fecha', { ascending: true });

const months = ["ENE", "FEB", "MAR", "ABR", "MAY", "JUN", "JUL", "AGO", "SET", "OCT", "NOV", "DIC"];

const today = new Date();
today.setHours(0, 0, 0, 0);

let imminentEvent = null;

const allTourEvents = (rawEvents || []).map((event: any) => {
  const d = new Date(event.fecha + 'T12:00:00'); // Evitar descalces de zona horaria
  const day = d.getDate();
  const monthName = months[d.getMonth()];
  const year = d.getFullYear();
  const fullDateStr = event.fecha.replace(/-/g, '');

  const eventDateMidnight = new Date(event.fecha + 'T00:00:00');
  const diffTime = eventDateMidnight.getTime() - today.getTime();
  const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));
  const isPast = diffDays < 0 || event.fecha === '2026-08-08';
  const isWithinOneWeek = diffDays >= 0 && diffDays <= 7;
  const isUpcoming = diffDays >= 0 && !isPast;

  // Metadatos parseados desde descripcion
  let meta: any = {};
  try {
    if (event.descripcion && typeof event.descripcion === 'string' && event.descripcion.trim().startsWith('{')) {
      meta = JSON.parse(event.descripcion);
    }
  } catch (e) {}

  let videoUrl = event.video_url || meta.video_url;
  if (!videoUrl) {
    if (event.fecha === '2026-08-08') {
      videoUrl = 'https://res.cloudinary.com/dhgifjpkh/video/upload/v1786559998/expo_familia_cfjxai.mp4';
    } else if (event.fecha === '2026-09-12' || (event.lugar && event.lugar.toLowerCase().includes('olimpo'))) {
      videoUrl = 'https://res.cloudinary.com/dhgifjpkh/video/upload/v1789429380/OLIMPO_REEL_SOCIAL2_4K_baja_dqki2z.mp4';
    } else {
      videoUrl = null;
    }
  }

  let galleryUrl = meta.gallery_url || meta.album_url || null;
  if (!galleryUrl) {
    const venueLower = (event.lugar || '').toLowerCase();
    const nameLower = (event.nombre || '').toLowerCase();
    if (event.fecha === '2026-09-12' || venueLower.includes('olimpo') || nameLower.includes('olimpo')) {
      galleryUrl = '/galeria#album-section-temuco-2026-show-en-vivo-olimpo-club';
    } else if (venueLower.includes('saavedra') || nameLower.includes('saavedra')) {
      galleryUrl = '/galeria#album-section-puerto-saavedra-2026';
    } else if (venueLower.includes('pocoyan') || nameLower.includes('pocoyan')) {
      galleryUrl = '/galeria#album-section-pocoyan-2026';
    } else if (venueLower.includes('queule') || nameLower.includes('queule')) {
      galleryUrl = '/galeria#album-section-queule-2025';
    } else if (venueLower.includes('toltén') || venueLower.includes('tolten') || nameLower.includes('toltén') || nameLower.includes('tolten')) {
      galleryUrl = '/galeria#album-section-tolten-2025';
    } else if (venueLower.includes('gorbea') || nameLower.includes('gorbea')) {
      galleryUrl = '/galeria#album-section-expo-gorbea-2025';
    } else if (venueLower.includes('lautaro') || nameLower.includes('lautaro')) {
      galleryUrl = '/galeria#album-section-lautaro-2025';
    }
  }

  const isBocaDeLobos = event.fecha === '2026-09-18' && (
    (event.lugar && event.lugar.toLowerCase().includes('boca')) ||
    (event.nombre && event.nombre.toLowerCase().includes('boca'))
  );

  const tieneEntradas = meta.tiene_entradas !== undefined 
    ? Boolean(meta.tiene_entradas) 
    : (isBocaDeLobos ? true : false);
  const ticketUrl = meta.ticket_url || (isBocaDeLobos ? 'https://portaldisc.com/evento/bandabrunaenbocadelobos' : null);
  const imagenFlyer = event.imagen || (isBocaDeLobos ? '/assets/images/flyers/flyer_boca_de_lobos.webp' : null);

  let venueText = event.lugar || 'Por confirmar';
  if (isBocaDeLobos && (!event.lugar || event.lugar === 'PRONTO')) {
    venueText = 'Boca de Lobos';
  }

  let titleText = event.nombre;
  if (isBocaDeLobos && (!event.nombre || event.nombre === 'Show Fiestas Patrias')) {
    titleText = 'Banda Bruna en Boca de Lobos';
  }

  if (isUpcoming && !imminentEvent) {
    imminentEvent = {
      ...event,
      nombre: titleText,
      lugar: venueText,
      day,
      monthName,
      diffDays,
      tieneEntradas,
      ticketUrl,
      imagen: imagenFlyer
    };
  }

  const isNegociacion = (event.lugar && event.lugar.toLowerCase().includes('negociación')) || 
                        (event.lugar && event.lugar.toLowerCase().includes('negociacion')) ||
                        (event.nombre && event.nombre.toLowerCase().includes('negociación')) ||
                        (event.nombre && event.nombre.toLowerCase().includes('negociacion'));

  const rawHora = event.hora || event.time;
  const timeDisplay = isNegociacion ? 'Por confirmar' : (rawHora ? (rawHora.includes(':') ? `${rawHora} hrs` : `${rawHora}`) : (isBocaDeLobos ? '22:00 hrs' : 'Horario por confirmar'));

  return {
    id: event.id,
    date: isNegociacion ? '—' : day,
    month: monthName,
    year: year,
    time: timeDisplay,
    title: titleText,
    venue: venueText,
    location: event.ciudad || '',
    mapUrl: '#',
    statusType: isNegociacion ? 'pending' : 'confirmed',
    fullDate: fullDateStr,
    rawFecha: event.fecha,
    isWithinOneWeek,
    diffDays,
    isPast,
    videoUrl,
    galleryUrl,
    imagen: imagenFlyer,
    tieneEntradas,
    ticketUrl
  };
});

const upcomingEvents = allTourEvents.filter(e => !e.isPast);
const pastEvents = allTourEvents.filter(e => e.isPast);

const calendarEvents = allTourEvents.map(e => ({
  fecha: e.rawFecha,
  title: e.title,
  venue: e.venue,
  location: e.location,
  statusType: e.statusType,
  isPast: e.isPast
}));

const heroImages = [
  "/assets/images/hero/hero_1.webp",
  "/assets/images/hero/hero_2.webp",
  "/assets/images/hero/hero_3.webp",
  "/assets/images/hero/hero_4.webp",
  "/assets/images/hero/hero_5.webp",
  "/assets/images/hero/hero_6.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1783398590/compressed_BB29_ncdsn8.webp",
  // Fotos adicionales para el Hero Slide:
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1784414189/compressed_20250322-_DSC8302_iiqi8k.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1784414123/compressed_DSC01050_r8fjdr.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1784414120/compressed_DSC00983_tcabl4.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1784414124/compressed_DSC00953_zemfwn.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1784414182/compressed_20250322-_DSC8018_bqynkm.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1784414191/compressed_20250322-_DSC8359_pl7ubh.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1784414152/compressed_DSC02356_1_l5mqsc.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1784414172/compressed_20250201230759_DSC00081_1_jv8mqo.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1789438483/compressed_IMG_4525_uqtzfg.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1789438482/compressed_IMG_4490_xutyjf.webp"
];

// Cargar estadísticas desde Supabase
const { data: dbConfig } = await supabase
  .from('configuracion')
  .select('*')
  .eq('id', 1)
  .single();

const config = dbConfig || {};
const stats = {
  musiciansTrajectory: config.cant_trayectoria !== undefined && config.cant_trayectoria !== null ? config.cant_trayectoria : (socialStats.musiciansTrajectory || 15),
  stageYears: config.cant_escenarios !== undefined && config.cant_escenarios !== null ? config.cant_escenarios : (socialStats.stageYears || 10),
  instagramFollowers: Math.max(
    Number(config.cant_instagram) || 0,
    Number(socialStats.instagramFollowers) || 0,
    3488
  ),
  facebookFriends: Math.max(
    Number(config.cant_facebook) || 0,
    Number(socialStats.facebookFriends) || 0,
    4971
  ),
  youtubeSubscribers: Math.max(
    Number(config.cant_youtube) || 0,
    Number(socialStats.youtubeSubscribers) || 0,
    948
  ),
  tiktokFollowers: Math.max(
    Number(config.cant_tiktok) || 0,
    Number(socialStats.tiktokFollowers) || 0,
    1146
  ),
  regions: config.cant_regiones !== undefined && config.cant_regiones !== null ? config.cant_regiones : (socialStats.regions || 5)
};

// Cargar testimonios aprobados
const { data: dbTestimonios } = await supabase
  .from('testimonios')
  .select('*')
  .eq('aprobado', true)
  .order('created_at', { ascending: false });

const testimonios = dbTestimonios || [];


// Cargar publicaciones sociales aprobadas editorialmente desde Supabase (P1/P2)
let editorialSocialPosts: any[] = [];
try {
  const { data: dbPosts, error: postsErr } = await supabase
    .from('social_posts')
    .select('*')
    .eq('show_on_web', true)
    .eq('disponible', true)
    .order('web_order', { ascending: true })
    .limit(6);

  if (!postsErr && dbPosts && dbPosts.length > 0) {
    editorialSocialPosts = dbPosts;
  }
} catch (err) {
  console.error("Error al cargar publicaciones sociales aprobadas:", err);
}
