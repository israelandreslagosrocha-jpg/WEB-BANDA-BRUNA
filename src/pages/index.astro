<Layout title="Banda Bruna | Orquesta Oficial - Música en Vivo para Eventos y Festivales" description="Sitio oficial de Banda Bruna. Cumbia sureña y cumbia chilena en vivo para festivales municipales, bodas y eventos corporativos.">
  <link rel="preload" href="/assets/images/hero/hero_1.webp" as="image" fetchpriority="high" slot="head" />

  {activeLanzamiento && (
    <div 
      id="homepage-lanzamiento-block" 
      class="relative w-full overflow-hidden border-b border-white/10 py-6 px-6 md:px-12 z-30 transition-all duration-500"
      style={`background: linear-gradient(135deg, ${activeLanzamiento.color_secundario || '#090707'} 0%, #151111 50%, ${activeLanzamiento.color_principal || '#e21c1c'}22 100%);`}
      data-launch-date={activeLanzamiento.fecha_lanzamiento}
      data-supabase-url={import.meta.env.PUBLIC_SUPABASE_URL}
      data-supabase-key={import.meta.env.PUBLIC_SUPABASE_ANON_KEY}
      data-slug={activeLanzamiento.slug}
    >
      <!-- Background glow effects -->
      <div class="absolute inset-0 z-0 pointer-events-none select-none">
        <div class="absolute top-1/2 -translate-y-1/2 right-12 w-96 h-96 rounded-full blur-[120px] opacity-25" style={`background-color: ${activeLanzamiento.color_principal};`}></div>
        <!-- Canvas para las luces interactivas -->
        <canvas id="lanzamiento-lights-canvas" class="absolute inset-0 w-full h-full opacity-60"></canvas>
      </div>

      <!-- Main Layout -->
      <div class="relative z-10 max-w-[1400px] mx-auto flex flex-col lg:flex-row items-center justify-between gap-6 lg:gap-12">
        
        <!-- Left: Text info -->
        <div class="flex-grow flex flex-col md:flex-row items-center md:items-start gap-4 md:gap-6 text-center md:text-left">
          <!-- Release Image Thumbnail -->
          {activeLanzamiento.imagen_desktop ? (
            <img 
              src={activeLanzamiento.imagen_desktop} 
              alt={activeLanzamiento.nombre} 
              class="w-16 h-16 md:w-20 md:h-20 rounded-lg object-cover border border-white/10 shadow-lg shadow-black/40 hover:scale-[1.03] transition-transform duration-300 shrink-0" 
            />
          ) : (
            <div class="w-16 h-16 md:w-20 md:h-20 bg-slate-950 border border-white/10 rounded-lg flex items-center justify-center text-2xl shrink-0">
              🚀
            </div>
          )}
          
          <div class="flex-grow">
            <div class="flex items-center justify-center md:justify-start gap-2.5 mb-1.5 flex-wrap">
              <span 
                class="text-[9px] font-extrabold tracking-widest px-2.5 py-0.5 rounded-sm uppercase font-title"
                style={`background-color: ${activeLanzamiento.color_principal}; color: #ffffff;`}
              >
                {activeLanzamiento.tipo === 'videoclip' ? 'Videoclip Oficial' : activeLanzamiento.tipo === 'album' ? 'Nuevo Álbum / EP' : 'Nuevo Single'}
              </span>
              <span id="lanzamiento-badge-estado" class="text-gold-bruna text-[10px] font-extrabold tracking-widest uppercase font-title animate-pulse">
                PRÓXIMO ESTRENO
              </span>
            </div>
            <h3 class="text-lg md:text-xl font-extrabold font-title tracking-wide text-white uppercase mb-1 leading-tight">
              {activeLanzamiento.titulo}
            </h3>
            <p class="text-xs text-slate-350 font-light max-w-2xl leading-relaxed">
              <strong class="text-white font-medium">{activeLanzamiento.bold_text}</strong> {activeLanzamiento.descripcion}
            </p>
          </div>
        </div>

        <!-- Middle/Right: Countdown & CTA -->
        <div class="flex flex-col sm:flex-row items-center gap-6 shrink-0 w-full lg:w-auto justify-end">
          
          <!-- Countdown container -->
          <div id="lanzamiento-countdown-container" class="flex items-center gap-3">
            <div class="flex flex-col items-center justify-center bg-black/40 border border-white/5 rounded-lg px-3 py-2 w-14 backdrop-blur-sm">
              <span id="countdown-days" class="text-lg md:text-xl font-extrabold text-white font-mono leading-none">00</span>
              <span class="text-[8px] text-slate-500 uppercase tracking-widest font-bold mt-1">Días</span>
