  <!-- Interactive Scripts (Sliders, Counters, Video Player Modals) -->
  <script>
    // HERO BACKGROUND SLIDER LOGIC
    const slides = document.querySelectorAll('.hero-slide');
    const prevBtn = document.getElementById('hero-prev');
    const nextBtn = document.getElementById('hero-next');
    
    let currentIndex = 0;
    let autoplayInterval;
    const slideDuration = 6000; // 6 seconds per slide
    
    function showSlide(index) {
      if (index >= slides.length) currentIndex = 0;
      else if (index < 0) currentIndex = slides.length - 1;
      else currentIndex = index;
      
      slides.forEach((slide, idx) => {
        if (idx === currentIndex) {
          slide.classList.remove('opacity-0', 'scale-105');
          slide.classList.add('opacity-100', 'scale-100');
        } else {
          slide.classList.remove('opacity-100', 'scale-100');
          slide.classList.add('opacity-0', 'scale-105');
        }
      });
    }
    
    function startAutoplay() {
      clearInterval(autoplayInterval);
      autoplayInterval = setInterval(() => {
        showSlide(currentIndex + 1);
      }, slideDuration);
    }
    
    if (nextBtn && prevBtn) {
      nextBtn.addEventListener('click', () => {
        showSlide(currentIndex + 1);
        startAutoplay();
      });
      
      prevBtn.addEventListener('click', () => {
        showSlide(currentIndex - 1);
        startAutoplay();
      });
    }
    
    // Initialize slider
    showSlide(0);
    startAutoplay();

    // COUNT UP ANIMATION LOGIC FOR STATISTICS
    function setupCountUp() {
      const counters = document.querySelectorAll('[data-count-target]');
      if (counters.length === 0) return;

      // Respetar preferencia de accesibilidad (prefers-reduced-motion)
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const counter = entry.target;
            const target = parseFloat(counter.getAttribute('data-count-target') || '0');
            const duration = 2000; // 2 seconds animation
            const startTime = performance.now();
            const prefix = counter.getAttribute('data-count-prefix') || '';
            const suffix = counter.getAttribute('data-count-suffix') || '';
            const isDecimal = counter.hasAttribute('data-count-decimal');

            function animate(currentTime) {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / duration, 1);
              
              // Easing function outQuad
              const easeProgress = progress * (2 - progress);
              
              let currentVal = easeProgress * target;
              
              if (isDecimal) {
                counter.textContent = prefix + currentVal.toFixed(1).replace('.', ',') + suffix;
              } else {
                counter.textContent = prefix + Math.floor(currentVal).toLocaleString('es-CL') + suffix;
              }

              if (progress < 1) {
                requestAnimationFrame(animate);
              } else {
                if (isDecimal) {
                  counter.textContent = prefix + target.toFixed(1).replace('.', ',') + suffix;
                } else {
                  counter.textContent = prefix + target.toLocaleString('es-CL') + suffix;
                }
              }
            }

            requestAnimationFrame(animate);
            observer.unobserve(counter);
          }
        });
      }, { threshold: 0.1 });

      counters.forEach(counter => {
        observer.observe(counter);
      });
    }

    setupCountUp();

    // CARGA DINÁMICA DE TESTIMONIOS APROBADOS DESDE SUPABASE EN TIEMPO REAL
    async function loadDynamicTestimonios() {
      const section = document.getElementById('testimonios-section');
      const grid = document.getElementById('testimonios-grid');
      if (!section || !grid) return;

      try {
        const { data: dbTestimonios, error } = await supabase
          .from('testimonios')
          .select('*')
          .eq('aprobado', true)
          .order('created_at', { ascending: false });

        if (error || !dbTestimonios || dbTestimonios.length === 0) {
          if (grid.children.length === 0) {
            section.classList.add('hidden');
          }
          return;
        }

        section.classList.remove('hidden');
        grid.innerHTML = dbTestimonios.map((item: any) => {
          const rating = item.calificacion || 5;
          const stars = '★'.repeat(rating) + '☆'.repeat(5 - rating);
          const sub = [item.cargo_cliente, item.organizacion_cliente].filter(Boolean).join(' — ');
          return `
            <blockquote class="bg-[#0b132b]/80 border border-white/10 p-6 rounded-2xl text-left relative flex flex-col justify-between group hover:border-gold-bruna/30 transition-all duration-300 shadow-xl">
              <div>
                <span class="text-gold-bruna text-5xl font-serif absolute top-4 left-4 opacity-10 leading-none select-none pointer-events-none">“</span>
                <div class="flex gap-1 text-gold-bruna text-xs mb-3.5 pl-3">${stars}</div>
                <p class="text-xs text-slate-300 italic font-light relative z-10 pl-3 leading-relaxed mb-6">
                  "${item.contenido}"
                </p>
              </div>
              <cite class="block pl-3 not-italic border-t border-white/5 pt-4">
                <strong class="text-white text-xs font-bold font-title uppercase block tracking-wider group-hover:text-gold-bruna transition-colors">${item.nombre_cliente}</strong>
                ${sub ? `<span class="text-[11px] text-slate-400 uppercase tracking-wide block mt-1 leading-tight">${sub}</span>` : ''}
              </cite>
            </blockquote>
          `;
        }).join('');
      } catch (err) {
        console.error("Error al cargar testimonios:", err);
      }
    }

    // MODAL DE VIDEO DE EVENTOS PASADOS
    function setupEventVideoModal() {
      const modal = document.getElementById('event-video-modal');
      const modalCard = document.getElementById('event-video-modal-card');
      const player = document.getElementById('event-video-player') as HTMLVideoElement;
      const titleEl = document.getElementById('event-video-modal-title');
      const galleryBtn = document.getElementById('index-event-video-gallery-btn') as HTMLAnchorElement;
      const closeBtn = document.getElementById('close-event-video-modal');

      if (!modal || !player) return;

      function openModal(videoUrl: string, title: string, galleryUrl?: string) {
        player.src = videoUrl;
        if (titleEl) titleEl.textContent = title || 'Resumen de Show';
        if (galleryBtn) {
          galleryBtn.href = galleryUrl || '/galeria';
        }
        modal.classList.remove('hidden');
        setTimeout(() => {
          modal.classList.remove('opacity-0');
          if (modalCard) modalCard.classList.remove('scale-95');
        }, 10);
        player.play().catch(() => {});
      }

      function closeModal() {
        modal.classList.add('opacity-0');
        if (modalCard) modalCard.classList.add('scale-95');
        setTimeout(() => {
          modal.classList.add('hidden');
          player.pause();
          player.src = '';
        }, 300);
      }

      document.querySelectorAll('[data-open-event-video]').forEach(el => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const videoUrl = el.getAttribute('data-open-event-video');
          const title = el.getAttribute('data-event-title');
          const galleryUrl = el.getAttribute('data-event-gallery');
          if (videoUrl) openModal(videoUrl, title || '', galleryUrl || '');
        });
      });

      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
          closeModal();
        }
      });
    }

    loadDynamicTestimonios();
    setupEventVideoModal();
    setupEventFlyerModal();

    function setupEventFlyerModal() {
      const modal = document.getElementById('event-flyer-modal');
      const modalCard = document.getElementById('event-flyer-modal-card');
      const imgEl = document.getElementById('event-flyer-modal-image') as HTMLImageElement;
      const titleEl = document.getElementById('event-flyer-modal-title');
      const linkEl = document.getElementById('event-flyer-modal-link') as HTMLAnchorElement;
      const galleryBtn = document.getElementById('event-flyer-modal-gallery-btn') as HTMLAnchorElement;
      const closeBtn = document.getElementById('close-event-flyer-modal');

      if (!modal || !imgEl) return;

      function openModal(url: string, title: string, galleryUrl?: string | null) {
        imgEl.src = url;
        if (titleEl) titleEl.textContent = title || 'Afiche Oficial';
        if (linkEl) linkEl.href = url;
        if (galleryBtn) {
          if (galleryUrl) {
            galleryBtn.href = galleryUrl;
            galleryBtn.classList.remove('hidden');
            galleryBtn.classList.add('inline-flex');
          } else {
            galleryBtn.classList.add('hidden');
            galleryBtn.classList.remove('inline-flex');
          }
        }
        modal.classList.remove('hidden');
        setTimeout(() => {
          modal.classList.remove('opacity-0');
          if (modalCard) modalCard.classList.remove('scale-95');
        }, 10);
      }

      function closeModal() {
        modal.classList.add('opacity-0');
        if (modalCard) modalCard.classList.add('scale-95');
        setTimeout(() => {
          modal.classList.add('hidden');
          imgEl.src = '';
        }, 300);
      }

      document.querySelectorAll('[data-open-event-flyer]').forEach(el => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const url = el.getAttribute('data-open-event-flyer');
          const title = el.getAttribute('data-event-title');
          const gallery = el.getAttribute('data-event-gallery');
          if (url) openModal(url, title || '', gallery);
        });
      });

      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
      });
    }

    // Carrusel de videos en vivo en Home (Sección El Show en Directo)
    function setupHomeLiveVideoCarousel() {
      const homeCarousel = document.getElementById('home-live-carousel');
      if (!homeCarousel) return;

      const homePrev = document.getElementById('home-live-prev');
      const homeNext = document.getElementById('home-live-next');
      const homeDots = document.querySelectorAll('[data-home-slide]');
      const homeTabs = document.querySelectorAll('[data-home-tab]');
      const homeVideos = document.querySelectorAll('#home-live-carousel video');
      const homeTag = document.getElementById('home-live-tag');
      const homeTitle = document.getElementById('home-live-title');
      const homeDesc = document.getElementById('home-live-desc');

      const homeSlidesData = [
        {
          tag: "REGISTRO OFICIAL EN ESCENARIO",
          title: "Puerto Saavedra · Explanada Costera",
          desc: "Más de 5.000 personas en vivo. Audio directo de consola sin pistas pregrabadas."
        },
        {
          tag: "EN VIVO · BANDA BRUNA",
          title: "La Energía del Show en Vivo",
          desc: "Una muestra auténtica de Banda Bruna sobre el escenario. Experimenta la potencia del sonido en vivo."
        },
        {
          tag: "FIESTAS PATRIAS 2026 · EN VIVO",
          title: "Show en Vivo · Escenario Principal",
          desc: "Toda la energía, ritmo y potencia bailable de Banda Bruna ante una multitud festiva."
        },
        {
          tag: "CONVOCATORIA Y FIESTA · EN VIVO",
          title: "Fiesta y Convocatoria · Escenario Central",
          desc: "El público disfrutando y coreando el repertorio tropical en una noche inolvidable."
        },
        {
          tag: "EN VIVO · VICTORIA",
          title: "Vagabundo · En Vivo desde Victoria",
          desc: "Toda la potencia, ritmo y convocatoria de Banda Bruna haciendo bailar al público de Victoria con el clásico \"Vagabundo\"."
        }
      ];

      let homeSlideIndex = 0;

      function updateHomeCarousel(index) {
        homeVideos.forEach((v) => {
          if (v instanceof HTMLVideoElement) v.pause();
        });

        homeSlideIndex = index;
        if (homeCarousel) {
          homeCarousel.style.transform = `translateX(-${homeSlideIndex * 100}%)`;
        }

        homeDots.forEach((d, i) => {
          if (i === homeSlideIndex) {
            d.classList.add('bg-white');
            d.classList.remove('bg-white/40');
          } else {
            d.classList.remove('bg-white');
            d.classList.add('bg-white/40');
          }
        });

        homeTabs.forEach((tab, i) => {
          if (i === homeSlideIndex) {
            tab.classList.add('border-gold-bruna/60', 'bg-gold-bruna/10');
            tab.classList.remove('border-white/10', 'bg-slate-900/60');
          } else {
            tab.classList.remove('border-gold-bruna/60', 'bg-gold-bruna/10');
            tab.classList.add('border-white/10', 'bg-slate-900/60');
          }
        });

        if (homeSlidesData[homeSlideIndex]) {
          if (homeTag) homeTag.textContent = homeSlidesData[homeSlideIndex].tag;
          if (homeTitle) homeTitle.textContent = homeSlidesData[homeSlideIndex].title;
          if (homeDesc) homeDesc.textContent = homeSlidesData[homeSlideIndex].desc;
        }
      }

      homePrev?.addEventListener('click', () => {
        let nextIdx = homeSlideIndex - 1;
        if (nextIdx < 0) nextIdx = homeSlidesData.length - 1;
        updateHomeCarousel(nextIdx);
      });

      homeNext?.addEventListener('click', () => {
        let nextIdx = homeSlideIndex + 1;
        if (nextIdx >= homeSlidesData.length) nextIdx = 0;
        updateHomeCarousel(nextIdx);
      });

      homeDots.forEach((dot, idx) => {
        dot.addEventListener('click', () => updateHomeCarousel(idx));
      });

      homeTabs.forEach((tab, idx) => {
        tab.addEventListener('click', () => updateHomeCarousel(idx));
      });
    }

    setupHomeLiveVideoCarousel();

    document.addEventListener('astro:after-swap', () => {
      setupCountUp();
      loadDynamicTestimonios();
      setupEventVideoModal();
      setupEventFlyerModal();
      setupHomeLiveVideoCarousel();
    });
  </script>

  <!-- Modal Emergente de Video para Eventos Pasados -->
  <div id="event-video-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/85 backdrop-blur-md p-4 hidden opacity-0 transition-opacity duration-300">
    <div id="event-video-modal-card" class="bg-slate-900 border border-white/10 rounded-2xl overflow-hidden max-w-2xl w-full shadow-2xl relative flex flex-col transform scale-95 transition-transform duration-300">
      <!-- Header del Modal -->
      <div class="flex items-center justify-between px-5 py-3.5 border-b border-white/10 bg-slate-950">
        <div class="flex items-center gap-2 overflow-hidden">
          <span class="text-[9px] bg-gold-bruna/20 text-gold-bruna font-bold px-2 py-0.5 rounded border border-gold-bruna/30 uppercase tracking-wider flex-shrink-0">SHOW REALIZADO</span>
          <h3 id="event-video-modal-title" class="text-xs font-bold font-title text-white uppercase tracking-wide truncate">Resumen del Evento</h3>
        </div>
        <button type="button" id="close-event-video-modal" aria-label="Cerrar modal" class="text-slate-400 hover:text-white text-lg font-bold w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors flex-shrink-0">
          ✕
        </button>
      </div>
      <!-- Reproductor de Video -->
      <div class="relative aspect-video bg-black flex items-center justify-center">
        <video id="event-video-player" controls class="w-full h-full object-contain"></video>
      </div>
      <!-- Footer del Modal -->
      <div class="p-3.5 bg-slate-950/90 border-t border-white/5 flex items-center justify-between text-[11px] text-slate-400">
        <span class="flex items-center gap-1.5 font-light">
          <span>🎬</span> Cobertura de presentación en vivo
        </span>
        <a 
          id="index-event-video-gallery-btn" 
          href="/galeria" 
          class="text-gold-bruna hover:underline font-bold uppercase tracking-wider text-[10px] flex items-center gap-1"
        >
          <span>📸</span> Ver Fotos en Galería →
        </a>
      </div>
    </div>
  </div>

  <!-- Modal Emergente de Flyer / Afiche de Eventos -->
  <div id="event-flyer-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-md p-4 hidden opacity-0 transition-opacity duration-300">
    <div id="event-flyer-modal-card" class="bg-slate-900 border border-white/10 rounded-2xl overflow-hidden max-w-lg w-full shadow-2xl relative flex flex-col transform scale-95 transition-transform duration-300 max-h-[90vh]">
      <!-- Header del Modal -->
      <div class="flex items-center justify-between px-5 py-3 border-b border-white/10 bg-slate-950">
        <div class="flex items-center gap-2 overflow-hidden">
          <span class="text-[9px] bg-gold-bruna/20 text-gold-bruna font-bold px-2 py-0.5 rounded border border-gold-bruna/30 uppercase tracking-wider flex-shrink-0">AFICHE OFICIAL</span>
          <h3 id="event-flyer-modal-title" class="text-xs font-bold font-title text-white uppercase tracking-wide truncate">Afiche del Evento</h3>
        </div>
        <button type="button" id="close-event-flyer-modal" aria-label="Cerrar modal" class="text-slate-400 hover:text-white text-lg font-bold w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors flex-shrink-0">
          ✕
        </button>
      </div>
      <!-- Imagen del Flyer -->
      <div class="p-2 bg-black flex items-center justify-center overflow-auto flex-grow">
        <img id="event-flyer-modal-image" src="" alt="Flyer del Evento" class="max-w-full max-h-[70vh] object-contain rounded-lg" />
      </div>
      <!-- Footer del Modal -->
      <div class="p-3.5 bg-slate-950/90 border-t border-white/5 flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-400">
        <a id="event-flyer-modal-gallery-btn" href="/galeria" class="hidden text-[10px] text-purple-400 hover:text-purple-300 font-bold uppercase tracking-wider items-center gap-1">
          <span>📸</span> Ver Álbum en Galería →
        </a>
        <a id="event-flyer-modal-link" href="#" target="_blank" rel="noopener" class="text-[10px] text-gold-bruna font-bold uppercase tracking-wider hover:underline flex items-center gap-1 ml-auto">
          Abrir en tamaño completo ↗
        </a>
      </div>
    </div>
  </div>
</Layout>
