                >
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zm5.495 17.305c-.215.353-.677.463-1.03.248-2.868-1.753-6.48-2.15-10.732-1.176-.403.092-.81-.16-.902-.563-.092-.403.16-.81.563-.902 4.65-1.064 8.627-.61 11.854 1.362.353.216.464.678.247 1.031zm1.467-3.26c-.27.44-.847.585-1.287.315-3.284-2.02-8.29-2.607-12.177-1.427-.492.15-1.018-.13-1.168-.622-.15-.492.13-1.017.622-1.168 4.444-1.348 9.957-.7 13.7 1.61.44.27.585.848.315 1.288zm.13-3.39c-3.94-2.34-10.45-2.556-14.237-1.407-.604.183-1.246-.16-1.43-0.764-.183-.604.16-1.246.764-1.43 4.354-1.32 11.536-1.07 16.082 1.63.543.32.722 1.026.4 1.57-.32.544-1.027.722-1.57.402z"/></svg>
                </a>
              )}
              {activeLanzamiento.plataformas_links?.youtube && (
                <a 
                  href={activeLanzamiento.plataformas_links.youtube} 
                  target="_blank" 
                  rel="noopener"
                  class="w-10 h-10 rounded-full bg-[#FF0000]/10 border border-[#FF0000]/25 hover:border-[#FF0000]/50 hover:bg-[#FF0000]/20 text-[#FF0000] flex items-center justify-center transition-all hover:scale-105 active:scale-95 cursor-pointer"
                  title="Ver Videoclip en YouTube"
                >
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.545 12 3.545 12 3.545s-7.518 0-9.388.508a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.508 9.388.508 9.388.508s7.518 0 9.388-.508a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                </a>
              )}
              {activeLanzamiento.plataformas_links?.instagram && (
                <a 
                  href={activeLanzamiento.plataformas_links.instagram} 
                  target="_blank" 
                  rel="noopener"
                  class="w-10 h-10 rounded-full bg-pink-500/10 border border-pink-500/25 hover:border-pink-500/50 hover:bg-pink-500/20 text-pink-400 flex items-center justify-center transition-all hover:scale-105 active:scale-95 cursor-pointer"
                  title="Ver en Instagram"
                >
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
                </a>
              )}
            </div>

            <a 
              id="lanzamiento-btn-cta"
              href={`/${activeLanzamiento.slug}`} 
              class="w-full sm:w-auto bg-gradient-to-r from-gold-bruna to-gold-bruna-hover text-black px-6 py-3 rounded-md font-extrabold text-xs tracking-widest hover:scale-105 active:scale-95 transition-all text-center uppercase shadow-lg shadow-gold-bruna/10 cursor-pointer block whitespace-nowrap"
            >
              {isLanzamientoDisponible ? 'VER VIDEOCLIP' : 'IR AL LANZAMIENTO'}
            </a>
          </div>

        </div>

      </div>
    </div>

    <!-- Countdown Javascript Client-side Script -->
    <script is:inline>
      (function() {
        const block = document.getElementById('homepage-lanzamiento-block');
        if (!block) return;

        const launchDateStr = block.getAttribute('data-launch-date');
        if (!launchDateStr) return;

        let launchDate = new Date(launchDateStr).getTime();
        const countdownContainer = document.getElementById('lanzamiento-countdown-container');
        const badgeEstado = document.getElementById('lanzamiento-badge-estado');
        
        const daysEl = document.getElementById('countdown-days');
        const hoursEl = document.getElementById('countdown-hours');
        const minutesEl = document.getElementById('countdown-minutes');
        const secondsEl = document.getElementById('countdown-seconds');

        // Consulta en tiempo real a Supabase para evitar desfases por caché estática (SSG)
        const supabaseUrl = block.getAttribute('data-supabase-url');
        const supabaseKey = block.getAttribute('data-supabase-key');
        const slug = block.getAttribute('data-slug');

        if (supabaseUrl && supabaseKey && slug) {
          fetch(`${supabaseUrl}/rest/v1/lanzamientos?slug=eq.${slug}&select=fecha_lanzamiento`, {
            headers: {
              'apikey': supabaseKey,
              'Authorization': `Bearer ${supabaseKey}`
            }
          })
          .then(res => res.json())
          .then(data => {
            if (data && data.length > 0 && data[0].fecha_lanzamiento) {
              launchDate = new Date(data[0].fecha_lanzamiento).getTime();
              updateTimer();
            }
          })
          .catch(err => console.error("Error al obtener fecha en tiempo real:", err));
        }

        function updateTimer() {
          const now = new Date().getTime();
          const distance = launchDate - now;

          if (distance <= 0) {
            // Lanzado
            if (countdownContainer) countdownContainer.style.display = 'none';
            if (badgeEstado) {
              badgeEstado.textContent = '¡YA DISPONIBLE!';
              badgeEstado.className = 'text-green-400 text-[10px] font-extrabold tracking-widest uppercase font-title border border-green-500/20 bg-green-950/40 px-2 py-0.5 rounded-sm';
            }
            const platformContainer = document.getElementById('lanzamiento-plataformas-home');
            if (platformContainer) {
              platformContainer.style.display = 'flex';
            }
            const ctaBtn = document.getElementById('lanzamiento-btn-cta');
            if (ctaBtn) {
              ctaBtn.textContent = 'VER VIDEOCLIP';
            }
            clearInterval(timerInterval);
            return;
          }

          // Calcular tiempos
          const days = Math.floor(distance / (1000 * 60 * 60 * 24));
          const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);

          // Mostrar
          if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
          if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
          if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
          if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');
        }

        let timerInterval;
        updateTimer();
        timerInterval = setInterval(updateTimer, 1000);

        // --- EFECTO DE LUCES INTERACTIVAS EN CANVAS ---
        const canvas = document.getElementById('lanzamiento-lights-canvas');
        if (canvas) {
          const ctx = canvas.getContext('2d');
          let width = canvas.width = canvas.offsetWidth;
          let height = canvas.height = canvas.offsetHeight;

          const particles = [];
          const colors = [
            'rgba(214, 175, 55, ', // Dorado
            'rgba(226, 28, 28, ',  // Rojo
            'rgba(255, 255, 255, ' // Blanco
          ];

          let mouse = { x: null, y: null };

          window.addEventListener('resize', () => {
            if (!canvas) return;
            width = canvas.width = canvas.offsetWidth;
            height = canvas.height = canvas.offsetHeight;
          });

          block.addEventListener('mousemove', (e) => {
            const rect = canvas.getBoundingClientRect();
            mouse.x = e.clientX - rect.left;
            mouse.y = e.clientY - rect.top;
            
            // Generar destellos de chispas en la posición del mouse de forma ocasional
            if (Math.random() < 0.3) {
              createSpark(mouse.x, mouse.y);
            }
          });

          block.addEventListener('mouseleave', () => {
            mouse.x = null;
            mouse.y = null;
          });

          class Particle {
            constructor(x, y, isSpark = false) {
              this.x = x || Math.random() * width;
              this.y = y || Math.random() * height + (isSpark ? 0 : 50);
              this.isSpark = isSpark;
              this.size = isSpark ? Math.random() * 2 + 1 : Math.random() * 25 + 5;
              this.baseColor = colors[Math.floor(Math.random() * colors.length)];
              this.opacity = Math.random() * 0.5 + 0.1;
              this.fadeSpeed = isSpark ? Math.random() * 0.03 + 0.01 : Math.random() * 0.005 + 0.001;
              this.vx = isSpark ? (Math.random() - 0.5) * 3 : (Math.random() - 0.5) * 0.6;
              this.vy = isSpark ? (Math.random() - 0.5) * 3 : -Math.random() * 0.5 - 0.1;
            }

            update() {
              this.x += this.vx;
              this.y += this.vy;
              this.opacity -= this.fadeSpeed;

              // En caso de ser una partícula flotante común, rebota suave en bordes X
              if (!this.isSpark) {
                if (this.x < 0 || this.x > width) this.vx *= -1;
              }

              // Interacción con el cursor (orbes huyen sutilmente)
              if (mouse.x !== null && mouse.y !== null && !this.isSpark) {
                const dx = this.x - mouse.x;
                const dy = this.y - mouse.y;
                const dist = Math.hypot(dx, dy);
                if (dist < 100) {
                  const force = (100 - dist) / 100;
                  this.vx += (dx / dist) * force * 0.1;
                  this.vy += (dy / dist) * force * 0.1;
                }
              }
            }

            draw() {
              ctx.save();
              ctx.beginPath();
              
              if (this.isSpark) {
                // Dibujar destellos con brillo radial
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fillStyle = this.baseColor + this.opacity + ')';
                ctx.shadowBlur = 10;
                ctx.shadowColor = 'rgba(214, 175, 55, 0.8)';
                ctx.fill();
              } else {
                // Dibujar orbes suaves de luz desenfocados (bokeh)
                const grad = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.size);
                grad.addColorStop(0, this.baseColor + this.opacity + ')');
                grad.addColorStop(0.5, this.baseColor + (this.opacity * 0.4) + ')');
                grad.addColorStop(1, this.baseColor + '0)');
                ctx.fillStyle = grad;
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
              }
              ctx.restore();
            }
          }

          function createSpark(x, y) {
            particles.push(new Particle(x, y, true));
          }

          // Generar orbes iniciales
          for (let i = 0; i < 15; i++) {
            particles.push(new Particle());
          }

          function animate() {
            if (!canvas) return;
            ctx.clearRect(0, 0, width, height);

            // Generar orbes de repuesto a medida que se desvanecen
            if (particles.filter(p => !p.isSpark).length < 15 && Math.random() < 0.05) {
              particles.push(new Particle(Math.random() * width, height + 30, false));
            }

            for (let i = particles.length - 1; i >= 0; i--) {
              const p = particles[i];
              p.update();
              p.draw();

              if (p.opacity <= 0 || p.x < -50 || p.x > width + 50 || p.y < -50) {
                particles.splice(i, 1);
              }
            }

            requestAnimationFrame(animate);
          }

          animate();
        }
      })();
    </script>
  )}
  
