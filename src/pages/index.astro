import Layout from '../layouts/Layout.astro';
import { 
  getLatestVideo, 
  getInstagramFeed, 
  getFacebookFeed 
} from '../services/socialApi.js';
import socialStats from '../data/socialStats.json';
import { supabase } from '../services/supabaseClient.js';
import NowPlayingWidget from '../modules/radio-monitor/components/NowPlayingWidget.astro';
import QuoteForm from '../components/forms/QuoteForm.astro';

// Fetch mock social data at build time
const latestVideo = getLatestVideo();
const instagramFeed = getInstagramFeed();
const facebookFeed = getFacebookFeed();

// Cargar eventos activos desde Supabase ordenados por fecha ascendente
const { data: rawEvents } = await supabase
  .from('eventos')
  .select('*')
  .eq('publicado', true)
  .order('fecha', { ascending: true });

const months = ["ENE", "FEB", "MAR", "ABR", "MAY", "JUN", "JUL", "AGO", "SET", "OCT", "NOV", "DIC"];

const today = new Date();
today.setHours(0, 0, 0, 0);

let imminentEvent = null;

const upcomingEvents = (rawEvents || []).map((event: any) => {
  const d = new Date(event.fecha + 'T12:00:00'); // Evitar descalces de zona horaria
  const day = d.getDate();
  const monthName = months[d.getMonth()];
  const year = d.getFullYear();
  const fullDateStr = event.fecha.replace(/-/g, '');

  const eventDateMidnight = new Date(event.fecha + 'T00:00:00');
  const diffTime = eventDateMidnight.getTime() - today.getTime();
  const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));
  const isPast = diffDays < 0 || event.fecha === '2026-08-08';
  const isWithinOneWeek = diffDays >= 0 && diffDays <= 7;
  const isUpcoming = diffDays >= 0 && !isPast;
  const videoUrl = event.video_url || (event.fecha === '2026-08-08' ? 'https://res.cloudinary.com/dhgifjpkh/video/upload/v1786559998/expo_familia_cfjxai.mp4' : null);

  if (isUpcoming && !imminentEvent) {
    imminentEvent = {
      ...event,
      day,
      monthName,
      diffDays
    };
  }

  const isNegociacion = (event.lugar && event.lugar.toLowerCase().includes('negociación')) || 
                        (event.lugar && event.lugar.toLowerCase().includes('negociacion')) ||
                        (event.nombre && event.nombre.toLowerCase().includes('negociación')) ||
                        (event.nombre && event.nombre.toLowerCase().includes('negociacion'));

  const rawHora = event.hora || event.time;
  const timeDisplay = isNegociacion ? 'Por confirmar' : (rawHora ? (rawHora.includes(':') ? `${rawHora} hrs` : `${rawHora}`) : 'Horario por confirmar');

  return {
    id: event.id,
    date: isNegociacion ? '—' : day,
    month: monthName,
    year: year,
    time: timeDisplay,
    title: event.nombre,
    venue: event.lugar || 'Por confirmar',
    location: event.ciudad || '',
    mapUrl: '#',
    statusType: isNegociacion ? 'pending' : 'confirmed',
    fullDate: fullDateStr,
    isWithinOneWeek,
    diffDays,
    isPast,
    videoUrl,
    imagen: event.imagen || null
  };
}).slice(0, 5);

const heroImages = [
  "/assets/images/hero/hero_1.webp",
  "/assets/images/hero/hero_2.webp",
  "/assets/images/hero/hero_3.webp",
  "/assets/images/hero/hero_4.webp",
  "/assets/images/hero/hero_5.webp",
  "/assets/images/hero/hero_6.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1783398590/compressed_BB29_ncdsn8.webp",
  // Fotos adicionales para el Hero Slide:
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1784414189/compressed_20250322-_DSC8302_iiqi8k.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1784414123/compressed_DSC01050_r8fjdr.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1784414120/compressed_DSC00983_tcabl4.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1784414124/compressed_DSC00953_zemfwn.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1784414182/compressed_20250322-_DSC8018_bqynkm.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1784414191/compressed_20250322-_DSC8359_pl7ubh.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1784414152/compressed_DSC02356_1_l5mqsc.webp",
  "https://res.cloudinary.com/dhgifjpkh/image/upload/v1784414172/compressed_20250201230759_DSC00081_1_jv8mqo.webp"
];

// Cargar estadísticas desde Supabase
const { data: dbConfig } = await supabase
  .from('configuracion')
  .select('*')
  .eq('id', 1)
  .single();

const config = dbConfig || {};
const stats = {
  musiciansTrajectory: config.cant_trayectoria !== undefined && config.cant_trayectoria !== null ? config.cant_trayectoria : socialStats.musiciansTrajectory,
  stageYears: config.cant_escenarios !== undefined && config.cant_escenarios !== null ? config.cant_escenarios : socialStats.stageYears,
  instagramFollowers: config.cant_instagram !== undefined && config.cant_instagram !== null ? config.cant_instagram : socialStats.instagramFollowers,
  facebookFriends: config.cant_facebook !== undefined && config.cant_facebook !== null ? config.cant_facebook : socialStats.facebookFriends,
  youtubeSubscribers: config.cant_youtube !== undefined && config.cant_youtube !== null ? config.cant_youtube : socialStats.youtubeSubscribers,
  tiktokFollowers: config.cant_tiktok !== undefined && config.cant_tiktok !== null ? config.cant_tiktok : socialStats.tiktokFollowers,
  regions: config.cant_regiones !== undefined && config.cant_regiones !== null ? config.cant_regiones : socialStats.regions
};

// Cargar testimonios aprobados
const { data: dbTestimonios } = await supabase
  .from('testimonios')
  .select('*')
  .eq('aprobado', true)
  .order('created_at', { ascending: false });

const testimonios = dbTestimonios || [];

// Cargar lanzamiento activo desde Supabase para la campaña musical
let activeLanzamiento = null;
try {
  const { data: dbLanzamientos } = await supabase
    .from('lanzamientos')
    .select('*')
    .eq('estado', 'publicado')
    .eq('mostrar_home', true)
    .lte('fecha_inicio', new Date().toISOString())
    .order('orden', { ascending: true })
    .order('fecha_lanzamiento', { ascending: true })
    .limit(1);

  if (dbLanzamientos && dbLanzamientos.length > 0) {
    activeLanzamiento = dbLanzamientos[0];
    if (activeLanzamiento.slug === 'ahogado-en-un-bar') {
      activeLanzamiento.imagen_desktop = 'https://res.cloudinary.com/dhgifjpkh/image/upload/v1783052331/compressed_BANDA_BRUNA_-_AHOGADO_EN_UN_BAR_mgwlvi.webp';
    }
  }
} catch (err) {
  console.error("Error al cargar lanzamiento activo:", err);
}

const isLanzamientoDisponible = activeLanzamiento && new Date(activeLanzamiento.fecha_lanzamiento).getTime() <= Date.now();

// Cargar publicaciones sociales aprobadas editorialmente desde Supabase (P1/P2)
let editorialSocialPosts: any[] = [];
try {
  const { data: dbPosts, error: postsErr } = await supabase
    .from('social_posts')
    .select('*')
    .eq('show_on_web', true)
    .eq('disponible', true)
    .order('web_order', { ascending: true })
    .limit(6);

  if (!postsErr && dbPosts && dbPosts.length > 0) {
    editorialSocialPosts = dbPosts;
  }
} catch (err) {
  console.error("Error al cargar publicaciones sociales aprobadas:", err);
}
