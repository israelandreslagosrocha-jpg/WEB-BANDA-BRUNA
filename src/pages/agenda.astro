---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../services/supabaseClient.js';

// Cargar eventos activos desde Supabase ordenados por fecha ascendente
const { data: rawEvents } = await supabase
  .from('eventos')
  .select('*')
  .eq('publicado', true)
  .order('fecha', { ascending: true });

const months = ["ENE", "FEB", "MAR", "ABR", "MAY", "JUN", "JUL", "AGO", "SET", "OCT", "NOV", "DIC"];

const today = new Date();
today.setHours(0, 0, 0, 0);

const events = (rawEvents || []).map((event: any) => {
  const d = new Date(event.fecha + 'T12:00:00'); // Evitar descalces de zona horaria
  const day = d.getDate();
  const monthName = months[d.getMonth()];
  const year = d.getFullYear();
  const fullDateStr = event.fecha.replace(/-/g, '');

  const eventDateMidnight = new Date(event.fecha + 'T00:00:00');
  const isPast = eventDateMidnight.getTime() < today.getTime() || event.fecha === '2026-08-08';
  const videoUrl = event.video_url || (event.fecha === '2026-08-08' ? 'https://res.cloudinary.com/dhgifjpkh/video/upload/v1786559998/expo_familia_cfjxai.mp4' : 'https://res.cloudinary.com/dhgifjpkh/video/upload/v1781905596/2.9K_views_119_reactions_Algo_de_lo_que_fue_Puerto_Saavedra_este_fin_de_semana_Gracias_a_todo_ese_lindo_Pu%CC%81blico_Este_sa%CC%81b_b0gyk9.mp4');

  // Metadatos parseados desde descripcion
  let meta: any = {};
  try {
    if (event.descripcion && typeof event.descripcion === 'string' && event.descripcion.trim().startsWith('{')) {
      meta = JSON.parse(event.descripcion);
    }
  } catch (e) {}

  const isBocaDeLobos = event.fecha === '2026-09-18';

  const tieneEntradas = meta.tiene_entradas !== undefined 
    ? Boolean(meta.tiene_entradas) 
    : (isBocaDeLobos ? true : false);

  const ticketUrl = meta.ticket_url || (isBocaDeLobos ? 'https://portaldisc.com/evento/bandabrunaenbocadelobos' : null);

  const imagenFlyer = event.imagen || (isBocaDeLobos ? '/assets/images/flyers/flyer_boca_de_lobos.webp' : null);

  const isNegociacion = (event.lugar && event.lugar.toLowerCase().includes('negociación')) || 
                        (event.lugar && event.lugar.toLowerCase().includes('negociacion')) ||
                        (event.nombre && event.nombre.toLowerCase().includes('negociación')) ||
                        (event.nombre && event.nombre.toLowerCase().includes('negociacion'));

  // Horario
  const rawHora = event.hora || event.time;
  const timeDisplay = isNegociacion ? 'Por confirmar' : (rawHora ? (rawHora.includes(':') ? `${rawHora} hrs` : `${rawHora}`) : (isBocaDeLobos ? '22:00 hrs' : 'Horario por confirmar'));

  let venueText = event.lugar || 'Por confirmar';
  if (isBocaDeLobos && (!event.lugar || event.lugar === 'PRONTO')) {
    venueText = 'Boca de Lobos';
  }

  let titleText = event.nombre;
  if (isBocaDeLobos && (!event.nombre || event.nombre === 'Show Fiestas Patrias')) {
    titleText = 'Banda Bruna en Boca de Lobos';
  }

  const locationText = event.ciudad || '';
  const searchTerms = [venueText !== 'Por confirmar' ? venueText : '', locationText].filter(Boolean).join(' ').trim();

  let finalMapUrl: string | null = null;
  const hasCustomMap = (event.map_url && event.map_url !== '#' && event.map_url.startsWith('http')) || 
                       (event.mapUrl && event.mapUrl !== '#' && event.mapUrl.startsWith('http'));

  if (hasCustomMap) {
    finalMapUrl = event.map_url || event.mapUrl;
  } else if (searchTerms.length > 0) {
    finalMapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(searchTerms)}`;
  }

  return {
    id: event.id,
    date: isNegociacion ? '—' : day,
    month: monthName,
    year: year,
    time: timeDisplay,
    title: titleText,
    venue: venueText,
    location: locationText,
    mapUrl: finalMapUrl,
    statusType: isNegociacion ? 'pending' : 'confirmed',
    fullDate: fullDateStr,
    isPast,
    videoUrl,
    imagen: imagenFlyer,
    tieneEntradas,
    ticketUrl
  };
});

// Helper to generate Google Calendar links
const getGoogleCalendarUrl = (event: any) => {
  const dateStr = event.fullDate.replace(/-/g, '');
  const title = encodeURIComponent(event.title + " - Banda Bruna");
  const details = encodeURIComponent("Presentación en vivo de Banda Bruna. ¡Cumbia chilena y show familiar!");
  const location = encodeURIComponent(event.venue + ", " + event.location);
  return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${dateStr}T200000/${dateStr}T230000&details=${details}&location=${location}&sf=true&output=xml`;
};
---

<Layout title="Agenda de Conciertos | Banda Bruna - Fechas de Gira Oficial" description="Entérate de las próximas fechas de conciertos de Banda Bruna. Fiestas costumbristas, festivales y shows en vivo.">
  <section class="max-w-5xl mx-auto px-6 py-16 md:py-24">
    
    <div class="text-center mb-16">
      <span class="text-gold-bruna text-sm tracking-widest font-semibold uppercase block mb-1">PROGRAMACIÓN</span>
      <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold font-title uppercase">FECHAS DE GIRA</h1>
      <div class="w-12 h-0.5 bg-gold-bruna mx-auto mt-4"></div>
    </div>

    <!-- Concert schedule detailed timeline list -->
    <div class="bg-slate-900 border border-white/5 rounded-xl overflow-hidden shadow-2xl">
      <div class="p-6 md:p-8 bg-slate-950 border-b border-white/5">
        <h2 class="font-title font-bold text-lg text-white">Listado oficial de presentaciones</h2>
        <p class="text-xs text-slate-400 font-light mt-1">
          Fechas sujetas a cambios de última hora. Las actualizaciones de agenda se coordinan directamente en tiempo real.
        </p>
      </div>

      {events.length > 0 ? (
        <div class="divide-y divide-white/5">
          {events.map(event => (
            <div 
              class={`p-6 md:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6 transition-all ${
                event.isPast 
                  ? 'opacity-75 hover:opacity-100 bg-slate-950/60 hover:bg-slate-950/90 border-b border-white/5 hover:border-gold-bruna/40 cursor-pointer group/pastevent' 
                  : (event.imagen ? 'hover:bg-white/[0.02] cursor-pointer' : 'hover:bg-white/[0.01] cursor-default')
              }`}
              {...(event.isPast ? {
                'data-open-event-video': event.videoUrl || '',
                'data-event-title': `${event.title} — ${event.location || event.venue}`
              } : (event.imagen ? {
                'data-open-event-flyer': event.imagen,
                'data-event-title': `${event.title} — ${event.location || event.venue}`
              } : {}))}
            >
              
              <div class="flex gap-6 items-center">
                <!-- Calendar Date Block -->
                <div class={`w-16 h-16 bg-slate-950 border border-white/5 rounded-xl flex flex-col items-center justify-center text-center flex-shrink-0 ${event.isPast ? 'group-hover/pastevent:border-gold-bruna/40' : ''}`}>
                  <span class={`text-3xl font-extrabold font-title leading-none ${event.isPast ? 'text-slate-400 group-hover/pastevent:text-gold-bruna' : 'text-gold-bruna'}`}>{event.date}</span>
                  <span class="text-[10px] text-slate-500 font-semibold tracking-wider mt-1 uppercase">{event.month}</span>
                </div>
                
                <div>
                  <span class="text-slate-400 text-xs font-semibold">{event.year} — {event.time}</span>
                  <h3 class="font-title font-bold text-xl text-white mt-0.5 mb-1 tracking-wide">{event.title}</h3>
                  <p class="text-sm text-slate-400 font-light">
                    Recinto: {event.mapUrl ? (
                      <a href={event.mapUrl} target="_blank" rel="noopener" class="underline hover:text-gold-bruna transition-colors">{event.venue}</a>
                    ) : (
                      <span>{event.venue}</span>
                    )}{event.location ? <>, <strong>{event.location}</strong></> : null}
                  </p>
                </div>
              </div>

              <!-- Actions and states -->
              <div class="flex flex-wrap items-center gap-4 border-t md:border-t-0 pt-4 md:pt-0 justify-between md:justify-end">
                
                {event.isPast ? (
                  <div class="flex items-center gap-3">
                    <span class="bg-slate-800/90 border border-slate-700 text-slate-300 group-hover/pastevent:text-gold-bruna group-hover/pastevent:border-gold-bruna/50 text-[10px] font-bold px-3.5 py-1.5 rounded-full uppercase tracking-wider flex items-center gap-2 transition-colors shadow">
                      <span>🎬 SHOW REALIZADO</span>
                      <span class="text-[9px] bg-gold-bruna/20 text-gold-bruna px-2 py-0.5 rounded font-mono border border-gold-bruna/30">VER VIDEOS ▶</span>
                    </span>
                  </div>
                ) : (
                  <>
                    <div class="flex items-center gap-3">
                      {event.statusType === 'confirmed' ? (
                        <span class="bg-green-950/30 border border-green-500/20 text-green-400 text-[10px] font-bold px-3 py-1.5 rounded-full uppercase tracking-wider">
                          Confirmado
                        </span>
                      ) : (
                        <span class="bg-amber-950/30 border border-amber-500/20 text-amber-400 text-[10px] font-bold px-3 py-1.5 rounded-full uppercase tracking-wider">
                          Por Confirmar
                        </span>
                      )}
                    </div>

                    {event.statusType === 'confirmed' && (
                      <div class="flex flex-wrap items-center gap-2.5">
                        {event.tieneEntradas && event.ticketUrl && (
                          <a 
                            href={event.ticketUrl} 
                            target="_blank" 
                            rel="noopener" 
                            class="text-xs bg-gradient-to-r from-gold-bruna to-gold-bruna-hover hover:brightness-110 text-black font-extrabold px-4 py-2 rounded-lg transition-all flex items-center gap-1.5 shadow-md uppercase tracking-wider"
                          >
                            <span>🎟️</span> Comprar Entradas
                          </a>
                        )}
                        {event.imagen && (
                          <button 
                            type="button" 
                            data-open-event-flyer={event.imagen} 
                            data-event-title={`${event.title} — ${event.location || event.venue}`}
                            class="text-xs bg-gold-bruna/10 border border-gold-bruna/30 hover:bg-gold-bruna/20 text-gold-bruna px-3.5 py-2 rounded-lg transition-colors cursor-pointer flex items-center gap-1.5 font-bold uppercase tracking-wider"
                          >
                            <span>🖼️</span> Ver Flyer
                          </button>
                        )}
                        <a href={getGoogleCalendarUrl(event)} target="_blank" rel="noopener" class="text-xs bg-slate-950 border border-white/10 hover:border-gold-bruna text-slate-300 px-3.5 py-2 rounded-lg transition-colors cursor-pointer">
                          Añadir a Google Calendar
                        </a>
                      </div>
                    )}
                  </>
                )}

              </div>

            </div>
          ))}
        </div>
      ) : (
        <div class="p-12 text-center text-slate-400 flex flex-col items-center justify-center gap-4 min-h-[250px]">
          <span class="text-4xl">✨</span>
          <h3 class="font-title font-bold text-lg text-white uppercase tracking-wider">Próximas fechas muy pronto</h3>
          <p class="text-xs text-slate-400 max-w-md mx-auto font-light leading-relaxed">
            Actualmente nos encontramos preparando nuestro nuevo show y producciones. ¡Mantente atento a nuestras redes sociales para enterarte de las próximas fechas de conciertos en tu ciudad!
          </p>
        </div>
      )}
    </div>

    <!-- Booking promotion -->
    <div class="bg-slate-900 border border-white/5 rounded-xl p-8 mt-12 text-center max-w-2xl mx-auto">
      <h2 class="font-title font-bold text-xl text-white mb-2 uppercase">¿Quieres agendar una presentación?</h2>
      <p class="text-sm text-slate-400 font-light mb-6">
        Coordinamos fechas para festivales municipales, carnavales de verano, fiestas costumbristas y bodas. Realiza tu solicitud hoy para apartar tu cupo en nuestra gira 2026.
      </p>
      <a href="/contrataciones" class="bg-gold-bruna text-black px-8 py-3.5 rounded font-bold hover:scale-105 transition-all inline-block cursor-pointer">
        SOLICITAR COTIZACIÓN
      </a>
    </div>

  </section>

  <!-- Modal Emergente de Carrusel de Videos para Eventos Pasados -->
  <div id="event-video-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/85 backdrop-blur-md p-4 hidden opacity-0 transition-opacity duration-300">
    <div id="event-video-modal-card" class="bg-slate-900 border border-white/10 rounded-2xl overflow-hidden max-w-2xl w-full shadow-2xl relative flex flex-col transform scale-95 transition-transform duration-300">
      <!-- Header del Modal -->
      <div class="flex items-center justify-between px-5 py-3.5 border-b border-white/10 bg-slate-950">
        <div class="flex items-center gap-2 overflow-hidden">
          <span class="text-[9px] bg-gold-bruna/20 text-gold-bruna font-bold px-2 py-0.5 rounded border border-gold-bruna/30 uppercase tracking-wider flex-shrink-0">SHOW REALIZADO</span>
          <h3 id="event-video-modal-title" class="text-xs font-bold font-title text-white uppercase tracking-wide truncate">Resumen del Evento</h3>
        </div>
        <button type="button" id="close-event-video-modal" aria-label="Cerrar modal" class="text-slate-400 hover:text-white text-lg font-bold w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors flex-shrink-0 cursor-pointer">
          ✕
        </button>
      </div>

      <!-- Reproductor de Video con Flechas de Carrusel -->
      <div class="relative aspect-video bg-black flex items-center justify-center group">
        <video id="event-video-player" controls class="w-full h-full object-contain"></video>

        <!-- Botones de carrusel -->
        <button id="prev-event-video" type="button" aria-label="Video anterior" class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-black/75 hover:bg-gold-bruna hover:text-black text-white flex items-center justify-center transition-all cursor-pointer border border-white/20 z-20 shadow-lg font-bold">
          ❮
        </button>
        <button id="next-event-video" type="button" aria-label="Siguiente video" class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-black/75 hover:bg-gold-bruna hover:text-black text-white flex items-center justify-center transition-all cursor-pointer border border-white/20 z-20 shadow-lg font-bold">
          ❯
        </button>

        <!-- Indicador de video en carrusel -->
        <div class="absolute bottom-3 left-4 z-20 bg-black/80 px-2.5 py-1 rounded text-[10px] text-slate-300 font-mono flex items-center gap-1.5 border border-white/10 pointer-events-none">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          <span id="event-video-counter">Video 1 de 3</span>
        </div>
      </div>

      <!-- Footer del Modal con botón directo a Galería de Fotos -->
      <div class="p-4 bg-slate-950/95 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="flex items-center gap-2 text-xs text-slate-400">
          <span>🎬</span>
          <span id="event-video-caption" class="font-medium text-white truncate max-w-xs">Cobertura oficial del concierto en vivo</span>
        </div>
        <a 
          href="/galeria" 
          class="inline-flex items-center gap-2 bg-gradient-to-r from-gold-bruna to-gold-bruna-hover hover:brightness-110 text-black font-extrabold text-xs px-5 py-2.5 rounded-lg transition-all shadow-md uppercase tracking-wider font-title"
        >
          <span>📸</span> Ver Fotos en Galería
        </a>
      </div>
    </div>
  </div>

  <script>
    function setupEventVideoModal() {
      const modal = document.getElementById('event-video-modal');
      const modalCard = document.getElementById('event-video-modal-card');
      const player = document.getElementById('event-video-player') as HTMLVideoElement;
      const titleEl = document.getElementById('event-video-modal-title');
      const captionEl = document.getElementById('event-video-caption');
      const counterEl = document.getElementById('event-video-counter');
      const closeBtn = document.getElementById('close-event-video-modal');
      const prevBtn = document.getElementById('prev-event-video');
      const nextBtn = document.getElementById('next-event-video');

      if (!modal || !player) return;

      const pastVideos = [
        {
          title: "Show en Puerto Saavedra",
          url: "https://res.cloudinary.com/dhgifjpkh/video/upload/v1781905596/2.9K_views_119_reactions_Algo_de_lo_que_fue_Puerto_Saavedra_este_fin_de_semana_Gracias_a_todo_ese_lindo_Pu%CC%81blico_Este_sa%CC%81b_b0gyk9.mp4"
        },
        {
          title: "Presentación en Vivo Expo Familia Temuco",
          url: "https://res.cloudinary.com/dhgifjpkh/video/upload/v1786559998/expo_familia_cfjxai.mp4"
        },
        {
          title: "Gira Regional y Backstage",
          url: "https://res.cloudinary.com/dhgifjpkh/video/upload/v1782411607/WhatsApp_Video_2026-06-24_at_12.56.26_PM_oqdkzs.mp4"
        }
      ];

      let currentVideoIdx = 0;

      function updateVideoSlide(idx: number) {
        currentVideoIdx = (idx + pastVideos.length) % pastVideos.length;
        const v = pastVideos[currentVideoIdx];
        player.pause();
        player.src = v.url;
        if (counterEl) counterEl.textContent = `Video ${currentVideoIdx + 1} de ${pastVideos.length}`;
        if (captionEl) captionEl.textContent = v.title;
        player.play().catch(() => {});
      }

      function openModal(videoUrl: string, title: string) {
        // Si el video solicitado está en la lista o es nuevo, posicionar el índice
        const foundIdx = pastVideos.findIndex(v => v.url === videoUrl);
        if (foundIdx >= 0) {
          currentVideoIdx = foundIdx;
        } else if (videoUrl) {
          pastVideos.unshift({ title: title || 'Registro en Vivo', url: videoUrl });
          currentVideoIdx = 0;
        }

        const v = pastVideos[currentVideoIdx];
        player.src = v.url;
        if (titleEl) titleEl.textContent = title || 'Resumen de Show';
        if (captionEl) captionEl.textContent = v.title;
        if (counterEl) counterEl.textContent = `Video ${currentVideoIdx + 1} de ${pastVideos.length}`;

        modal.classList.remove('hidden');
        setTimeout(() => {
          modal.classList.remove('opacity-0');
          if (modalCard) modalCard.classList.remove('scale-95');
        }, 10);
        player.play().catch(() => {});
      }

      function closeModal() {
        modal.classList.add('opacity-0');
        if (modalCard) modalCard.classList.add('scale-95');
        setTimeout(() => {
          modal.classList.add('hidden');
          player.pause();
          player.src = '';
        }, 300);
      }

      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        updateVideoSlide(currentVideoIdx - 1);
      });

      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        updateVideoSlide(currentVideoIdx + 1);
      });

      document.querySelectorAll('[data-open-event-video]').forEach(el => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const videoUrl = el.getAttribute('data-open-event-video');
          const title = el.getAttribute('data-event-title');
          if (videoUrl) openModal(videoUrl, title || '');
        });
      });

      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
          closeModal();
        } else if (e.key === 'ArrowLeft' && !modal.classList.contains('hidden')) {
          updateVideoSlide(currentVideoIdx - 1);
        } else if (e.key === 'ArrowRight' && !modal.classList.contains('hidden')) {
          updateVideoSlide(currentVideoIdx + 1);
        }
      });
    }

    setupEventVideoModal();
    setupEventFlyerModal();

    function setupEventFlyerModal() {
      const modal = document.getElementById('event-flyer-modal');
      const modalCard = document.getElementById('event-flyer-modal-card');
      const imgEl = document.getElementById('event-flyer-modal-image') as HTMLImageElement;
      const titleEl = document.getElementById('event-flyer-modal-title');
      const linkEl = document.getElementById('event-flyer-modal-link') as HTMLAnchorElement;
      const closeBtn = document.getElementById('close-event-flyer-modal');

      if (!modal || !imgEl) return;

      function openModal(url: string, title: string) {
        imgEl.src = url;
        if (titleEl) titleEl.textContent = title || 'Afiche Oficial';
        if (linkEl) linkEl.href = url;
        modal.classList.remove('hidden');
        setTimeout(() => {
          modal.classList.remove('opacity-0');
          if (modalCard) modalCard.classList.remove('scale-95');
        }, 10);
      }

      function closeModal() {
        modal.classList.add('opacity-0');
        if (modalCard) modalCard.classList.add('scale-95');
        setTimeout(() => {
          modal.classList.add('hidden');
          imgEl.src = '';
        }, 300);
      }

      document.querySelectorAll('[data-open-event-flyer]').forEach(el => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const url = el.getAttribute('data-open-event-flyer');
          const title = el.getAttribute('data-event-title');
          if (url) openModal(url, title || '');
        });
      });

      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
      });
    }

    document.addEventListener('astro:after-swap', () => {
      setupEventVideoModal();
      setupEventFlyerModal();
    });
  </script>

  <!-- Modal Emergente de Flyer / Afiche de Eventos -->
  <div id="event-flyer-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-md p-4 hidden opacity-0 transition-opacity duration-300">
    <div id="event-flyer-modal-card" class="bg-slate-900 border border-white/10 rounded-2xl overflow-hidden max-w-lg w-full shadow-2xl relative flex flex-col transform scale-95 transition-transform duration-300 max-h-[90vh]">
      <!-- Header del Modal -->
      <div class="flex items-center justify-between px-5 py-3 border-b border-white/10 bg-slate-950">
        <div class="flex items-center gap-2 overflow-hidden">
          <span class="text-[9px] bg-gold-bruna/20 text-gold-bruna font-bold px-2 py-0.5 rounded border border-gold-bruna/30 uppercase tracking-wider flex-shrink-0">AFICHE OFICIAL</span>
          <h3 id="event-flyer-modal-title" class="text-xs font-bold font-title text-white uppercase tracking-wide truncate">Afiche del Evento</h3>
        </div>
        <button type="button" id="close-event-flyer-modal" aria-label="Cerrar modal" class="text-slate-400 hover:text-white text-lg font-bold w-8 h-8 flex items-center justify-center rounded-full hover:bg-white/10 transition-colors flex-shrink-0">
          ✕
        </button>
      </div>
      <!-- Imagen del Flyer -->
      <div class="p-2 bg-black flex items-center justify-center overflow-auto flex-grow">
        <img id="event-flyer-modal-image" src="" alt="Flyer del Evento" class="max-w-full max-h-[70vh] object-contain rounded-lg" />
      </div>
      <!-- Footer del Modal -->
      <div class="p-3.5 bg-slate-950/90 border-t border-white/5 flex items-center justify-between text-[11px] text-slate-400">
        <span class="text-slate-400 font-light flex items-center gap-1.5">
          <span>📅</span> Presentación oficial confirmada
        </span>
