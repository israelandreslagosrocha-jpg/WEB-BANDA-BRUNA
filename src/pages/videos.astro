---
import Layout from '../layouts/Layout.astro';
import { getVideoPlaylists } from '../services/socialApi.js';
import { supabase } from '../services/supabaseClient.js';
import curatedFallback from '../data/curatedVideos.json';

export const prerender = false;

// 1. Catálogo base de alta disponibilidad (fallback)
const staticPlaylists = getVideoPlaylists();

// 2. Consulta de publicaciones dinámicas desde Supabase (los 5 videos autoadministrados de cada red)
let playlists = {
  youtube: [...staticPlaylists.youtube],
  facebook: [...staticPlaylists.facebook],
  instagram: [...staticPlaylists.instagram],
  tiktok: [...staticPlaylists.tiktok]
};

try {
  // Consultar en paralelo para máxima velocidad en SSR respetando web_order (1 al 5)
  const [ytRes, fbRes, igRes, ttRes] = await Promise.all([
    supabase
      .from('social_posts')
      .select('*')
      .eq('platform', 'youtube')
      .eq('disponible', true)
      .eq('show_on_web', true)
      .not('web_order', 'is', null)
      .order('web_order', { ascending: true })
      .limit(10),
    supabase
      .from('social_posts')
      .select('*')
      .eq('platform', 'facebook')
      .eq('disponible', true)
      .eq('show_on_web', true)
      .not('web_order', 'is', null)
      .order('web_order', { ascending: true })
      .limit(10),
    supabase
      .from('social_posts')
      .select('*')
      .eq('platform', 'instagram')
      .eq('disponible', true)
      .eq('show_on_web', true)
      .not('web_order', 'is', null)
      .order('web_order', { ascending: true })
      .limit(10),
    supabase
      .from('social_posts')
      .select('*')
      .eq('platform', 'tiktok')
      .eq('disponible', true)
      .eq('show_on_web', true)
      .not('web_order', 'is', null)
      .order('web_order', { ascending: true })
      .limit(10)
  ]);

  // Si hay videos de YouTube en Supabase, formateamos
  if (ytRes.data && ytRes.data.length > 0) {
    const seenYtOrders = new Set();
    const dedupedYt = ytRes.data.filter((v: any) => {
      if (seenYtOrders.has(v.web_order)) return false;
      seenYtOrders.add(v.web_order);
      return true;
    });

    const formattedYt = dedupedYt.map((v: any, idx: number) => {
      const orderIdx = (v.web_order || idx + 1) - 1;
      const fallbackItem = (curatedFallback as any)?.youtube?.[orderIdx];
      let thumb = v.thumbnail_url;
      if (!thumb || thumb.startsWith('/assets/images/') || (v.external_id && !thumb.includes(v.external_id))) {
        thumb = fallbackItem?.thumbnail || (v.external_id ? `https://i.ytimg.com/vi/${v.external_id}/hqdefault.jpg` : '');
      }
      return {
        id: v.external_id || `yt_${idx}`,
        title: v.title || fallbackItem?.title || 'Banda Bruna - Video Oficial',
        url: v.url || `https://www.youtube.com/watch?v=${v.external_id}`,
        embedId: v.external_id,
        thumbnail: thumb || `https://i.ytimg.com/vi/${v.external_id}/hqdefault.jpg`,
        duration: v.post_type === 'short' ? 'Short' : 'Oficial',
        category: v.post_type === 'short' ? 'YouTube Short' : 'YouTube Oficial'
      };
    });
    const uniqueYt = formattedYt.filter((v: any, i: number, arr: any[]) => arr.findIndex((x: any) => x.embedId === v.embedId) === i);
    const remainingYt = staticPlaylists.youtube.filter((sv: any) => !uniqueYt.some((fy: any) => fy.id === sv.id || fy.embedId === sv.embedId));
    playlists.youtube = [...uniqueYt, ...remainingYt].slice(0, 5);
  }

  // Si hay reels de Facebook en Supabase
  if (fbRes.data && fbRes.data.length > 0) {
    const formattedFb = fbRes.data.map((r: any, idx: number) => {
      const orderIdx = (r.web_order || idx + 1) - 1;
      const fallbackItem = (curatedFallback as any)?.facebook?.[orderIdx];
      let thumb = r.thumbnail_url;
      if ((!thumb || thumb.startsWith('/assets/images/')) && fallbackItem?.thumbnail) {
        thumb = fallbackItem.thumbnail;
      }
      return {
        id: r.external_id || `fb_${idx}`,
        title: r.title || r.caption || fallbackItem?.title || 'Banda Bruna en vivo',
        url: r.url,
        thumbnail: thumb || '/assets/images/facebook/fb_fiestas_patrias.webp',
        duration: '0:45',
        category: 'Facebook Reel'
      };
    });
    const remainingFb = staticPlaylists.facebook.filter((sf: any) => !formattedFb.some((ff: any) => ff.id === sf.id || ff.url === sf.url));
    playlists.facebook = [...formattedFb, ...remainingFb].slice(0, 5);
  }

  // Si hay reels de Instagram en Supabase
  if (igRes.data && igRes.data.length > 0) {
    const formattedIg = igRes.data.map((r: any, idx: number) => {
      const orderIdx = (r.web_order || idx + 1) - 1;
      const fallbackItem = (curatedFallback as any)?.instagram?.[orderIdx];
      let thumb = r.thumbnail_url;
      if ((!thumb || thumb.startsWith('/assets/images/')) && fallbackItem?.thumbnail) {
        thumb = fallbackItem.thumbnail;
      }
      return {
        id: r.external_id || `ig_${idx}`,
        title: r.title || r.caption || fallbackItem?.title || 'Banda Bruna en Instagram',
        url: r.url,
        thumbnail: thumb || '/assets/images/instagram/ig_boca_de_lobos.webp',
        duration: '0:45',
        category: 'Instagram Reel'
      };
    });
    const remainingIg = staticPlaylists.instagram.filter((si: any) => !formattedIg.some((fi: any) => fi.id === si.id || fi.url === si.url));
    playlists.instagram = [...formattedIg, ...remainingIg].slice(0, 5);
  }

  // Si hay videos de TikTok en Supabase
  if (ttRes.data && ttRes.data.length > 0) {
    const formattedTt = ttRes.data.map((t: any, idx: number) => {
      const orderIdx = (t.web_order || idx + 1) - 1;
      const fallbackItem = (curatedFallback as any)?.tiktok?.[orderIdx];
      let thumb = t.thumbnail_url;
      if ((!thumb || thumb.startsWith('/assets/images/')) && fallbackItem?.thumbnail) {
        thumb = fallbackItem.thumbnail;
      }
      return {
        id: t.external_id || `tt_${idx}`,
        title: t.title || t.caption || fallbackItem?.title || 'Banda Bruna en TikTok',
        url: t.url,
        thumbnail: thumb || '/assets/images/tiktok/tiktok_minero.webp',
        duration: '0:45',
        category: 'TikTok Oficial'
      };
    });
    const remainingTt = staticPlaylists.tiktok.filter((st: any) => !formattedTt.some((ft: any) => ft.id === st.id || ft.url === st.url));
    playlists.tiktok = [...formattedTt, ...remainingTt].slice(0, 5);
  }
} catch (err) {
  console.warn('Error al cargar playlists desde Supabase, usando catálogo local:', err);
}
---

<Layout title="Vídeos | Banda Bruna - Videoclips Oficiales y Presentaciones en Vivo" description="Disfruta de la videoteca de Banda Bruna: presentaciones destacadas, videoclips de YouTube y Reels oficiales de Facebook.">
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-24">
    
